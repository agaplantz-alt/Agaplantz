  @prompt
    AgaPlantz
    
    Rare Tropical Plants & Tissue Culture Specimens
    Contact
    
    25 Fieldridge Cres Unit 46 Brampton, Ontario L6R 4G6 Canada
    agaplantz@gmail.com
    +1 (647) 621-3033
    Monday – Friday: 9:00 AM – 5:00 PM EST Saturday – Sunday: 11:00 AM – 4:00 PM EST
    Policies
    
    Return & Refund Policy
    Shipping Policy
    Payment Policy
    Terms of Service
    Privacy Policy
    Quick links
    
    FAQ
    Contact Us
    About Us
    © 2026 AgaPlantz. All rights reserved.
    Secure payments are processed through trusted payment providers., In quick links also add coming soon and pre-orders And we have to also add follow us on TikTok, Instagram, and Etsy at the bottom of everything, Fit page, So in a desktop version, I am not able to see the block cover the entire length horizontally so I want you to move the policy page right next to the contact page
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-footer-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    padding: {{ block.settings.padding_top }}px 0 {{ block.settings.padding_bottom }}px;
  }

  .ai-footer-container-{{ ai_gen_id }} {
    max-width: 100%;
    padding: 0 20px;
  }

  .ai-footer-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 2fr 3fr 1fr;
    gap: 40px;
    margin-bottom: 40px;
  }

  .ai-footer-column-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .ai-footer-contact-policies-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
  }

  .ai-footer-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 600;
    margin: 0 0 8px 0;
    color: {{ block.settings.heading_color }};
  }

  .ai-footer-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.6;
    margin: 0;
    color: {{ block.settings.text_color }};
  }

  .ai-footer-link-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.link_color }};
    text-decoration: none;
    transition: color 0.2s ease;
    display: block;
    line-height: 1.8;
  }

  .ai-footer-link-{{ ai_gen_id }}:hover {
    color: {{ block.settings.link_hover_color }};
  }

  .ai-footer-contact-item-{{ ai_gen_id }} {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    margin-bottom: 12px;
  }

  .ai-footer-contact-icon-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    margin-top: 2px;
  }

  .ai-footer-contact-icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    stroke: {{ block.settings.text_color }};
    fill: none;
  }

  .ai-footer-divider-{{ ai_gen_id }} {
    border: none;
    border-top: 1px solid {{ block.settings.divider_color }};
    margin: 30px 0;
  }

  .ai-footer-bottom-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 16px;
    align-items: center;
    text-align: center;
  }

  .ai-footer-social-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .ai-footer-social-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0;
  }

  .ai-footer-social-links-{{ ai_gen_id }} {
    display: flex;
    gap: 12px;
    align-items: center;
  }

  .ai-footer-social-link-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background-color: {{ block.settings.social_icon_background }};
    color: {{ block.settings.social_icon_color }};
    transition: all 0.2s ease;
    text-decoration: none;
  }

  .ai-footer-social-link-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.social_icon_hover_background }};
    color: {{ block.settings.social_icon_hover_color }};
    transform: translateY(-2px);
  }

  .ai-footer-social-link-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
    fill: currentColor;
  }

  .ai-footer-copyright-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0;
  }

  .ai-footer-payment-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size | minus: 2 }}px;
    color: {{ block.settings.text_color }};
    opacity: 0.8;
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-footer-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 30px;
    }

    .ai-footer-contact-policies-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 30px;
    }

    .ai-footer-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_top | times: 0.7 }}px 0 {{ block.settings.padding_bottom | times: 0.7 }}px;
    }

    .ai-footer-container-{{ ai_gen_id }} {
      padding: 0 16px;
    }

    .ai-footer-social-{{ ai_gen_id }} {
      flex-direction: column;
      gap: 12px;
    }
  }
{% endstyle %}

<footer class="ai-footer-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-footer-container-{{ ai_gen_id }}">
    <div class="ai-footer-grid-{{ ai_gen_id }}">
      <div class="ai-footer-column-{{ ai_gen_id }}">
        <h3 class="ai-footer-heading-{{ ai_gen_id }}">{{ block.settings.brand_heading }}</h3>
        {% if block.settings.brand_tagline != blank %}
          <p class="ai-footer-text-{{ ai_gen_id }}">{{ block.settings.brand_tagline }}</p>
        {% endif %}
      </div>

      <div class="ai-footer-contact-policies-{{ ai_gen_id }}">
        <div class="ai-footer-column-{{ ai_gen_id }}">
          <h3 class="ai-footer-heading-{{ ai_gen_id }}">{{ block.settings.contact_heading }}</h3>
          
          {% if block.settings.address != blank %}
            <div class="ai-footer-contact-item-{{ ai_gen_id }}">
              <div class="ai-footer-contact-icon-{{ ai_gen_id }}">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                  <circle cx="12" cy="10" r="3"></circle>
                </svg>
              </div>
              <p class="ai-footer-text-{{ ai_gen_id }}">{{ block.settings.address }}</p>
            </div>
          {% endif %}

          {% if block.settings.email != blank %}
            <div class="ai-footer-contact-item-{{ ai_gen_id }}">
              <div class="ai-footer-contact-icon-{{ ai_gen_id }}">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                  <polyline points="22,6 12,13 2,6"></polyline>
                </svg>
              </div>
              <a href="mailto:{{ block.settings.email }}" class="ai-footer-link-{{ ai_gen_id }}">{{ block.settings.email }}</a>
            </div>
          {% endif %}

          {% if block.settings.phone != blank %}
            <div class="ai-footer-contact-item-{{ ai_gen_id }}">
              <div class="ai-footer-contact-icon-{{ ai_gen_id }}">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                </svg>
              </div>
              <a href="tel:{{ block.settings.phone }}" class="ai-footer-link-{{ ai_gen_id }}">{{ block.settings.phone }}</a>
            </div>
          {% endif %}

          {% if block.settings.hours != blank %}
            <div class="ai-footer-contact-item-{{ ai_gen_id }}">
              <div class="ai-footer-contact-icon-{{ ai_gen_id }}">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"></circle>
                  <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
              </div>
              <div class="ai-footer-text-{{ ai_gen_id }}">{{ block.settings.hours }}</div>
            </div>
          {% endif %}
        </div>

        <div class="ai-footer-column-{{ ai_gen_id }}">
          <h3 class="ai-footer-heading-{{ ai_gen_id }}">{{ block.settings.policies_heading }}</h3>
          {% if block.settings.policy_link_1_text != blank and block.settings.policy_link_1_url != blank %}
            <a href="{{ block.settings.policy_link_1_url }}" class="ai-footer-link-{{ ai_gen_id }}">{{ block.settings.policy_link_1_text }}</a>
          {% endif %}
          {% if block.settings.policy_link_2_text != blank and block.settings.policy_link_2_url != blank %}
            <a href="{{ block.settings.policy_link_2_url }}" class="ai-footer-link-{{ ai_gen_id }}">{{ block.settings.policy_link_2_text }}</a>
          {% endif %}
          {% if block.settings.policy_link_3_text != blank and block.settings.policy_link_3_url != blank %}
            <a href="{{ block.settings.policy_link_3_url }}" class="ai-footer-link-{{ ai_gen_id }}">{{ block.settings.policy_link_3_text }}</a>
          {% endif %}
          {% if block.settings.policy_link_4_text != blank and block.settings.policy_link_4_url != blank %}
            <a href="{{ block.settings.policy_link_4_url }}" class="ai-footer-link-{{ ai_gen_id }}">{{ block.settings.policy_link_4_text }}</a>
          {% endif %}
          {% if block.settings.policy_link_5_text != blank and block.settings.policy_link_5_url != blank %}
            <a href="{{ block.settings.policy_link_5_url }}" class="ai-footer-link-{{ ai_gen_id }}">{{ block.settings.policy_link_5_text }}</a>
          {% endif %}
          {% if block.settings.policy_link_6_text != blank and block.settings.policy_link_6_url != blank %}
            <a href="{{ block.settings.policy_link_6_url }}" class="ai-footer-link-{{ ai_gen_id }}">{{ block.settings.policy_link_6_text }}</a>
          {% endif %}
        </div>
      </div>

      <div class="ai-footer-column-{{ ai_gen_id }}">
        <h3 class="ai-footer-heading-{{ ai_gen_id }}">{{ block.settings.quick_links_heading }}</h3>
        {% if block.settings.quick_link_1_text != blank and block.settings.quick_link_1_url != blank %}
          <a href="{{ block.settings.quick_link_1_url }}" class="ai-footer-link-{{ ai_gen_id }}">{{ block.settings.quick_link_1_text }}</a>
        {% endif %}
        {% if block.settings.quick_link_2_text != blank and block.settings.quick_link_2_url != blank %}
          <a href="{{ block.settings.quick_link_2_url }}" class="ai-footer-link-{{ ai_gen_id }}">{{ block.settings.quick_link_2_text }}</a>
        {% endif %}
        {% if block.settings.quick_link_3_text != blank and block.settings.quick_link_3_url != blank %}
          <a href="{{ block.settings.quick_link_3_url }}" class="ai-footer-link-{{ ai_gen_id }}">{{ block.settings.quick_link_3_text }}</a>
        {% endif %}
        {% if block.settings.quick_link_4_text != blank and block.settings.quick_link_4_url != blank %}
          <a href="{{ block.settings.quick_link_4_url }}" class="ai-footer-link-{{ ai_gen_id }}">{{ block.settings.quick_link_4_text }}</a>
        {% endif %}
        {% if block.settings.quick_link_5_text != blank and block.settings.quick_link_5_url != blank %}
          <a href="{{ block.settings.quick_link_5_url }}" class="ai-footer-link-{{ ai_gen_id }}">{{ block.settings.quick_link_5_text }}</a>
        {% endif %}
      </div>
    </div>

    <hr class="ai-footer-divider-{{ ai_gen_id }}">

    <div class="ai-footer-bottom-{{ ai_gen_id }}">
      {% if block.settings.show_social_links %}
        <div class="ai-footer-social-{{ ai_gen_id }}">
          <p class="ai-footer-social-text-{{ ai_gen_id }}">{{ block.settings.social_heading }}</p>
          <div class="ai-footer-social-links-{{ ai_gen_id }}">
            {% if block.settings.tiktok_url != blank %}
              <a href="{{ block.settings.tiktok_url }}" class="ai-footer-social-link-{{ ai_gen_id }}" target="_blank" rel="noopener" aria-label="TikTok">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                  <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1z"/>
                </svg>
              </a>
            {% endif %}
            {% if block.settings.instagram_url != blank %}
              <a href="{{ block.settings.instagram_url }}" class="ai-footer-social-link-{{ ai_gen_id }}" target="_blank" rel="noopener" aria-label="Instagram">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                  <rect x="2" y="2" width="20" height="20" rx="5" ry="5" fill="none" stroke="currentColor" stroke-width="2"/>
                  <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"/>
                  <circle cx="17.5" cy="6.5" r="1.5"/>
                </svg>
              </a>
            {% endif %}
            {% if block.settings.etsy_url != blank %}
              <a href="{{ block.settings.etsy_url }}" class="ai-footer-social-link-{{ ai_gen_id }}" target="_blank" rel="noopener" aria-label="Etsy">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                  <path d="M7.5 6.5h9v2h-9v-2zm0 4h9v2h-9v-2zm0 4h9v2h-9v-2zM5 3v18h14V3H5zm12 16H7V5h10v14z"/>
                </svg>
              </a>
            {% endif %}
          </div>
        </div>
      {% endif %}

      {% if block.settings.copyright_text != blank %}
        <p class="ai-footer-copyright-{{ ai_gen_id }}">{{ block.settings.copyright_text }}</p>
      {% endif %}
      {% if block.settings.payment_text != blank %}
        <p class="ai-footer-payment-text-{{ ai_gen_id }}">{{ block.settings.payment_text }}</p>
      {% endif %}
    </div>
  </div>
</footer>

