{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-acclimation-guide-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.section_padding }}px 20px;
    background-color: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
  }

  .ai-acclimation-guide__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.content_max_width }}px;
    margin: 0 auto;
  }

  .ai-acclimation-guide__header-{{ ai_gen_id }} {
    text-align: {{ block.settings.header_alignment }};
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .ai-acclimation-guide__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: 700;
    margin: 0 0 {{ block.settings.title_spacing }}px;
    color: {{ block.settings.title_color }};
    line-height: 1.2;
  }

  .ai-acclimation-guide__subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    margin: 0 0 {{ block.settings.subtitle_spacing }}px;
    color: {{ block.settings.subtitle_color }};
    line-height: 1.5;
  }

  .ai-acclimation-guide__intro-{{ ai_gen_id }} {
    font-size: {{ block.settings.intro_size }}px;
    line-height: 1.6;
    margin-bottom: {{ block.settings.intro_spacing }}px;
    color: {{ block.settings.text_color }};
  }

  .ai-acclimation-guide__divider-{{ ai_gen_id }} {
    height: 1px;
    background-color: {{ block.settings.divider_color }};
    margin: {{ block.settings.divider_spacing }}px 0;
    opacity: {{ block.settings.divider_opacity | divided_by: 100.0 }};
  }

  .ai-acclimation-guide__section-{{ ai_gen_id }} {
    margin-bottom: {{ block.settings.section_spacing }}px;
  }

  .ai-acclimation-guide__section-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.section_title_size }}px;
    font-weight: 600;
    margin: 0 0 {{ block.settings.section_title_spacing }}px;
    color: {{ block.settings.section_title_color }};
    line-height: 1.3;
  }

  .ai-acclimation-guide__step-{{ ai_gen_id }} {
    margin-bottom: {{ block.settings.step_spacing }}px;
    padding: {{ block.settings.step_padding }}px;
    background-color: {{ block.settings.step_background }};
    border-radius: {{ block.settings.step_border_radius }}px;
    border: {{ block.settings.step_border_width }}px solid {{ block.settings.step_border_color }};
  }

  .ai-acclimation-guide__step-header-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: {{ block.settings.step_header_spacing }}px;
  }

  .ai-acclimation-guide__step-number-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.step_number_size }}px;
    height: {{ block.settings.step_number_size }}px;
    border-radius: 50%;
    background-color: {{ block.settings.step_number_background }};
    color: {{ block.settings.step_number_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
    font-size: {{ block.settings.step_number_font_size }}px;
  }

  .ai-acclimation-guide__step-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.step_title_size }}px;
    font-weight: 600;
    margin: 0;
    color: {{ block.settings.step_title_color }};
  }

  .ai-acclimation-guide__step-content-{{ ai_gen_id }} {
    font-size: {{ block.settings.step_content_size }}px;
    line-height: 1.6;
    color: {{ block.settings.text_color }};
  }

  .ai-acclimation-guide__step-content-{{ ai_gen_id }} p {
    margin: 0 0 12px;
  }

  .ai-acclimation-guide__step-content-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  .ai-acclimation-guide__step-content-{{ ai_gen_id }} ul {
    margin: 12px 0;
    padding-left: 20px;
  }

  .ai-acclimation-guide__step-content-{{ ai_gen_id }} li {
    margin-bottom: 8px;
  }

  .ai-acclimation-guide__step-content-{{ ai_gen_id }} strong {
    font-weight: 600;
    color: {{ block.settings.highlight_color }};
  }

  .ai-acclimation-guide__list-{{ ai_gen_id }} {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .ai-acclimation-guide__list-item-{{ ai_gen_id }} {
    position: relative;
    padding-left: 24px;
    margin-bottom: 8px;
    font-size: {{ block.settings.list_item_size }}px;
    line-height: 1.6;
  }

  .ai-acclimation-guide__list-item-{{ ai_gen_id }}::before {
    content: "•";
    position: absolute;
    left: 8px;
    color: {{ block.settings.bullet_color }};
    font-weight: 600;
  }

  .ai-acclimation-guide__subsection-{{ ai_gen_id }} {
    margin: 16px 0;
  }

  .ai-acclimation-guide__subsection-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.subsection_title_size }}px;
    font-weight: 600;
    margin: 0 0 8px;
    color: {{ block.settings.subsection_title_color }};
  }

  .ai-acclimation-guide__schedule-{{ ai_gen_id }} {
    margin: 16px 0;
  }

  .ai-acclimation-guide__schedule-item-{{ ai_gen_id }} {
    padding: 12px;
    margin-bottom: 8px;
    background-color: {{ block.settings.schedule_background }};
    border-left: 3px solid {{ block.settings.schedule_accent }};
    border-radius: 4px;
  }

  .ai-acclimation-guide__schedule-label-{{ ai_gen_id }} {
    font-weight: 600;
    color: {{ block.settings.schedule_label_color }};
    margin-bottom: 4px;
  }

  .ai-acclimation-guide__faq-{{ ai_gen_id }} {
    margin-bottom: {{ block.settings.faq_spacing }}px;
  }

  .ai-acclimation-guide__faq-question-{{ ai_gen_id }} {
    font-size: {{ block.settings.faq_question_size }}px;
    font-weight: 600;
    margin: 0 0 8px;
    color: {{ block.settings.faq_question_color }};
  }

  .ai-acclimation-guide__faq-answer-{{ ai_gen_id }} {
    font-size: {{ block.settings.faq_answer_size }}px;
    line-height: 1.6;
    color: {{ block.settings.text_color }};
  }

  .ai-acclimation-guide__warning-{{ ai_gen_id }} {
    padding: 16px;
    background-color: {{ block.settings.warning_background }};
    border-left: 4px solid {{ block.settings.warning_accent }};
    border-radius: 4px;
    margin: 16px 0;
  }

  .ai-acclimation-guide__warning-{{ ai_gen_id }} p {
    margin: 0;
    font-size: {{ block.settings.step_content_size }}px;
    line-height: 1.6;
  }

  @media screen and (max-width: 749px) {
    .ai-acclimation-guide-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding | times: 0.6 }}px 16px;
    }

    .ai-acclimation-guide__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.7 }}px;
    }

    .ai-acclimation-guide__subtitle-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtitle_size | times: 0.85 }}px;
    }

    .ai-acclimation-guide__section-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.section_title_size | times: 0.85 }}px;
    }

    .ai-acclimation-guide__step-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.step_title_size | times: 0.9 }}px;
    }

    .ai-acclimation-guide__step-number-{{ ai_gen_id }} {
      width: {{ block.settings.step_number_size | times: 0.85 }}px;
      height: {{ block.settings.step_number_size | times: 0.85 }}px;
      font-size: {{ block.settings.step_number_font_size | times: 0.85 }}px;
    }
  }
{% endstyle %}

