{%- doc -%}
  AgaPlantz — the crochet line on the home page: heading, one product row from the crochet
  collection, up to four category tiles and a "gifts under $25" strip. Every string is a
  setting. No sale badges on purpose: crochet is excluded from every discount, so a card
  never shows a compare-at price. The product row disappears by itself while the collection
  is empty (products in draft, collection unpublished) so the band still reads as finished.
{%- enddoc -%}

{%- liquid
  assign coll = section.settings.collection
  assign max_items = section.settings.max_products
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif

  assign cta_url = section.settings.cta_url
  if cta_url == blank and coll != blank
    assign cta_url = coll.url
  endif

  assign gift_coll = section.settings.gift_collection
  assign gift_url = section.settings.gift_url
  if gift_url == blank and gift_coll != blank
    assign gift_url = gift_coll.url
  endif

  capture cards
    if coll != blank
      assign shown = 0
      paginate coll.products by 24
        for product in coll.products
          if shown >= max_items
            break
          endif
          assign chosen = product.selected_or_first_available_variant
          if chosen == blank or chosen.available == false
            continue
          endif
          assign card_image = chosen.image | default: product.featured_image
          assign shown = shown | plus: 1
          echo '<div class="agcr__card"><a class="agcr__card-link" href="' | append: product.url | append: '" aria-label="' | append: product.title | escape | append: '"><div class="agcr__media">'
          if card_image
            echo card_image | image_url: width: 700 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 25vw, 60vw', widths: '350, 700, 1050', alt: product.title
          else
            echo '<span class="agcr__noimage">' | append: product.title | append: '</span>'
          endif
          echo '</div><span class="agcr__title">' | append: product.title | append: '</span><span class="agcr__price">' | append: chosen.price | money | append: '</span></a></div>'
        endfor
      endpaginate
    endif
  endcapture
  assign cards = cards | strip
-%}

<div class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"></div>

<div
  class="section section--page-width{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %} agcr"
  style="--padding-block-start: {{ section.settings.padding-block-start }}px; --padding-block-end: {{ section.settings.padding-block-end }}px; --agcr-cols: {{ section.settings.columns }};"
>
  <div class="agcr__head">
    <div class="agcr__copy">
      {%- if section.settings.eyebrow != blank -%}<p class="agcr__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="agcr__heading">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="agcr__text">{{ section.settings.text }}</p>{%- endif -%}
    </div>
    {%- if section.settings.cta_label != blank and cta_url != blank -%}
      <a class="agcr__cta" href="{{ cta_url }}">{{ section.settings.cta_label }}</a>
    {%- endif -%}
  </div>

  {%- if cards != blank -%}
    <div class="agcr__track">{{ cards }}</div>
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
    <div class="agcr__tiles agcr__tiles--{{ section.blocks.size }}">
      {%- for block in section.blocks -%}
        {%- liquid
          assign t_coll = block.settings.collection
          assign t_url = block.settings.link
          if t_url == blank and t_coll != blank
            assign t_url = t_coll.url
          endif
          assign t_title = block.settings.title
          if t_title == blank and t_coll != blank
            assign t_title = t_coll.title
          endif
          assign t_image = block.settings.image
          if t_image == blank and t_coll != blank
            assign t_image = t_coll.image
          endif
        -%}
        <a class="agcr__tile" href="{{ t_url }}" {{ block.shopify_attributes }}>
          <span class="agcr__tile-media">
            {%- if t_image -%}
              {{ t_image | image_url: width: 600 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 33vw, 96px', widths: '200, 400, 600', alt: t_title }}
            {%- else -%}
              <span class="agcr__tile-glyph" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M5.6 18.4l2.1-2.1M16.3 7.7l2.1-2.1"/></svg>
              </span>
            {%- endif -%}
          </span>
          <span class="agcr__tile-copy">
            <span class="agcr__tile-title">{{ t_title }}</span>
            {%- if block.settings.text != blank -%}<span class="agcr__tile-text">{{ block.settings.text }}</span>{%- endif -%}
            <span class="agcr__tile-arrow" aria-hidden="true">&rarr;</span>
          </span>
        </a>
      {%- endfor -%}
    </div>
  {%- endif -%}

  {%- if section.settings.show_gift and gift_url != blank -%}
    <a class="agcr__gift" href="{{ gift_url }}">
      <span class="agcr__gift-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 12v9H4v-9"/><path d="M2 7h20v5H2z"/><path d="M12 21V7"/><path d="M12 7H7.5a2.5 2.5 0 1 1 0-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 1 0 0-5C13 2 12 7 12 7z"/></svg>
      </span>
      <span class="agcr__gift-copy">
        <span class="agcr__gift-title">{{ section.settings.gift_heading }}</span>
        {%- if section.settings.gift_text != blank -%}<span class="agcr__gift-text">{{ section.settings.gift_text }}</span>{%- endif -%}
      </span>
      <span class="agcr__gift-cta">{{ section.settings.gift_cta }} <span aria-hidden="true">&rarr;</span></span>
    </a>
  {%- endif -%}

  {%- if section.settings.note != blank -%}
    <p class="agcr__note">{{ section.settings.note }}</p>
  {%- endif -%}
</div>

{% stylesheet %}
  .agcr {
    padding-block-start: var(--padding-block-start, 64px);
    padding-block-end: var(--padding-block-end, 64px);
  }
  .agcr__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-block-end: 28px;
  }
  .agcr__copy { max-width: 60ch; }
  .agcr__eyebrow {
    margin: 0 0 8px;
    color: #B4693C;
    font-family: var(--font-body--family);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .agcr__heading {
    margin: 0;
    font-family: var(--font-accent--family);
    font-weight: 400;
    font-size: clamp(26px, 3.4vw, 34px);
    line-height: 1.15;
    text-wrap: pretty;
  }
  .agcr__text {
    margin: 10px 0 0;
    font-family: var(--font-body--family);
    font-size: 15px;
    line-height: 1.55;
    color: #56503F;
  }
  .agcr__cta {
    flex: none;
    display: inline-flex;
    align-items: center;
    padding: 12px 22px;
    border-radius: 2px;
    background: #5C6B4C;
    color: #FBF8F2;
    font-family: var(--font-body--family);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }
  .agcr__cta:hover, .agcr__cta:focus { opacity: 0.86; color: #FBF8F2; }

  .agcr__track {
    display: grid;
    grid-template-columns: repeat(var(--agcr-cols, 4), minmax(0, 1fr));
    column-gap: 12px;
    row-gap: 28px;
    margin-block-end: 32px;
  }
  .agcr__card { min-width: 0; }
  .agcr__card-link { display: block; color: inherit; text-decoration: none; }
  .agcr__media {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: 2px;
    background: rgb(47 42 34 / 0.05);
  }
  .agcr__media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .agcr__noimage {
    display: flex; align-items: center; justify-content: center; height: 100%; padding: 12px;
    font-family: var(--font-body--family); font-size: 0.875rem; text-align: center; color: #56503F;
  }
  .agcr__title {
    display: block; margin-block-start: 10px;
    font-family: var(--font-body--family); font-size: 1rem; line-height: 1.35; text-wrap: pretty;
  }
  .agcr__price { display: block; margin-block-start: 4px; font-family: var(--font-body--family); font-size: 1rem; }

  .agcr__tiles {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }
  .agcr__tiles--1 { grid-template-columns: minmax(0, 1fr); }
  .agcr__tiles--2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .agcr__tiles--4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .agcr__tile {
    display: grid;
    grid-template-rows: auto 1fr;
    overflow: hidden;
    border: 1px solid #DED3C2;
    border-radius: 4px;
    background: rgb(251 248 242 / 0.7);
    color: inherit;
    text-decoration: none;
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }
  .agcr__tile:hover, .agcr__tile:focus { border-color: #5C6B4C; background: #FBF8F2; }
  .agcr__tile-media {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: #E8EDE1;
  }
  .agcr__tile-media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .agcr__tile-glyph {
    display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; color: #5C6B4C;
  }
  .agcr__tile-glyph svg { width: 40px; height: 40px; }
  .agcr__tile-copy {
    position: relative;
    display: block;
    padding: 14px 44px 14px 16px;
  }
  .agcr__tile-title { display: block; font-family: var(--font-accent--family); font-size: 19px; line-height: 1.25; }
  .agcr__tile-text { display: block; margin-block-start: 4px; font-family: var(--font-body--family); font-size: 13px; line-height: 1.45; color: #56503F; }
  .agcr__tile-arrow {
    position: absolute; inset-inline-end: 14px; inset-block-start: 50%; transform: translateY(-50%);
    color: #5C6B4C; font-size: 18px;
  }

  .agcr__gift {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 18px;
    margin-block-start: 20px;
    padding: 18px 22px;
    border-radius: 4px;
    background: #5C6B4C;
    color: #FBF8F2;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }
  .agcr__gift:hover, .agcr__gift:focus { opacity: 0.92; color: #FBF8F2; }
  .agcr__gift-icon {
    display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px;
    border-radius: 50%; background: rgb(251 248 242 / 0.14);
  }
  .agcr__gift-icon svg { width: 22px; height: 22px; }
  .agcr__gift-copy { display: block; min-width: 0; }
  .agcr__gift-title { display: block; font-family: var(--font-accent--family); font-size: clamp(19px, 2.6vw, 23px); line-height: 1.25; }
  .agcr__gift-text { display: block; margin-block-start: 4px; font-family: var(--font-body--family); font-size: 14px; line-height: 1.5; opacity: 0.88; }
  .agcr__gift-cta { white-space: nowrap; font-family: var(--font-body--family); font-size: 12px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; }

  .agcr__note {
    margin: 18px 0 0;
    font-family: var(--font-body--family);
    font-size: 13px;
    line-height: 1.5;
    color: #56503F;
  }

  @media screen and (max-width: 749px) {
    .agcr__head { flex-direction: column; align-items: flex-start; gap: 16px; }
    .agcr__cta { width: 100%; justify-content: center; }
    .agcr__track {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      gap: 12px;
      scrollbar-width: none;
      -ms-overflow-style: none;
    }
    .agcr__track::-webkit-scrollbar { display: none; }
    .agcr__card { flex: 0 0 60%; scroll-snap-align: start; }
    .agcr__tiles, .agcr__tiles--2, .agcr__tiles--4 { grid-template-columns: minmax(0, 1fr); }
    .agcr__tile { grid-template-rows: none; grid-template-columns: 96px 1fr; }
    .agcr__tile-media { aspect-ratio: 1 / 1; height: 100%; }
    .agcr__tile-glyph svg { width: 28px; height: 28px; }
    .agcr__tile-copy { padding: 12px 40px 12px 14px; }
    .agcr__tile-title { font-size: 17px; }
    .agcr__gift { grid-template-columns: auto 1fr; gap: 14px; padding: 16px; }
    .agcr__gift-cta { grid-column: 2; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Crochet feature",
  "tag": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "New at AgaPlantz" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Flowers that never wilt" },
    { "type": "text", "id": "text", "label": "One line", "default": "Hand-crocheted flowers, bags and charms. No water, no light, no wilting." },
    { "type": "collection", "id": "collection", "label": "Collection for the product row" },
    { "type": "range", "id": "max_products", "label": "Products to show", "min": 4, "max": 8, "step": 1, "default": 8 },
    { "type": "range", "id": "columns", "label": "Columns on desktop", "min": 2, "max": 4, "step": 1, "default": 4 },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Shop crochet" },
    { "type": "url", "id": "cta_url", "label": "Button link", "info": "Leave blank to use the collection above." },
    { "type": "header", "content": "Gifts strip" },
    { "type": "checkbox", "id": "show_gift", "label": "Show the gifts strip", "default": true },
    { "type": "collection", "id": "gift_collection", "label": "Gifts collection" },
    { "type": "url", "id": "gift_url", "label": "Gifts link", "info": "Leave blank to use the gifts collection." },
    { "type": "text", "id": "gift_heading", "label": "Gifts heading", "default": "Gifts under $25" },
    { "type": "text", "id": "gift_text", "label": "Gifts line", "default": "Keychains, bag charms and flower hangings. Easy to post, easy to love." },
    { "type": "text", "id": "gift_cta", "label": "Gifts link label", "default": "See them all" },
    { "type": "header", "content": "Small print" },
    { "type": "text", "id": "note", "label": "Note under the band", "default": "Every piece is hand-crocheted by our artisan partner. Crochet is not included in plant discounts." },
    { "type": "header", "content": "Section layout" },
    { "type": "color", "id": "background_color", "label": "Background", "placeholder": "Default" },
    { "type": "range", "id": "padding-block-start", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding-block-end", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 64 }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Category tile",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Title", "info": "Leave blank to use the collection's name." },
        { "type": "text", "id": "text", "label": "One line" },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Leave blank to use the collection image." },
        { "type": "url", "id": "link", "label": "Link", "info": "Leave blank to use the collection." }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Crochet feature",
      "category": "Products",
      "blocks": [
        { "type": "tile", "settings": { "title": "Flowers", "text": "Roses, lilies and tulips in little pots." } },
        { "type": "tile", "settings": { "title": "Bags", "text": "Shell bags, granny bags and totes." } },
        { "type": "tile", "settings": { "title": "Gifts under $25", "text": "Keychains, charms and hangings." } }
      ]
    }
  ]
}
{% endschema %}
