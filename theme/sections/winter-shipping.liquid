{%- doc -%}
  AgaPlantz — "Worried about winter?" band for the home page, under the batch countdown.
  A photo of the packed box, one line, three facts and a link to the heat-pack add-on.

  The third fact is the offer. While `free_over` is set and `offer_ends` has not passed it reads
  "Free on orders $X+"; otherwise it shows the add-on's live price. That mirrors the automatic
  discount "Free Winter Heat Pack on Orders $100+" (Buy X get Y, ends 31 Mar 2027) and
  snippets/heat-pack-addon.liquid in the cart — change the threshold or the date in all three.

  The whole band stops rendering after `hide_after`, so it cannot sit on the home page in July.
  Dates carry the Toronto offset, like the countdown's.
{%- enddoc -%}

{%- liquid
  assign now_s = 'now' | date: '%s' | plus: 0
  assign show_band = true
  if section.settings.hide_after != blank
    assign hide_s = section.settings.hide_after | date: '%s' | plus: 0
    if now_s > hide_s
      assign show_band = false
    endif
  endif

  assign hp = section.settings.product
  assign offer_on = false
  if section.settings.free_over > 0
    assign offer_on = true
    if section.settings.offer_ends != blank
      assign offer_s = section.settings.offer_ends | date: '%s' | plus: 0
      if now_s > offer_s
        assign offer_on = false
      endif
    endif
  endif

  assign photo = section.settings.image | default: hp.featured_image
  assign link = section.settings.link | default: hp.url

  if show_band and section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
-%}

{%- if show_band -%}
  <div class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"></div>

  <div
    class="section section--page-width{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %} agwn"
    style="--padding-block-start: {{ section.settings.padding-block-start }}px; --padding-block-end: {{ section.settings.padding-block-end }}px;"
  >
    <div class="agwn__grid{% if photo == blank %} agwn__grid--nophoto{% endif %}">
      {%- if photo != blank -%}
        <div class="agwn__photo">
          {{
            photo
            | image_url: width: 720
            | image_tag:
              loading: 'lazy',
              widths: '240, 360, 480, 720',
              sizes: '(min-width: 750px) 240px, 112px',
              alt: section.settings.image_alt
          }}
        </div>
      {%- endif -%}

      <div class="agwn__copy">
        {%- if section.settings.eyebrow != blank -%}
          <p class="agwn__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2 class="agwn__heading">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}
          <p class="agwn__text">{{ section.settings.text }}</p>
        {%- endif -%}
      </div>

      <ul class="agwn__facts" role="list">
        {%- if section.settings.fact_1_title != blank -%}
          <li class="agwn__fact">
            <svg class="agwn__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 3c1 3.2 4.5 4.8 4.5 9a4.5 4.5 0 0 1-9 0c0-1.7.7-2.8 1.6-3.8.3 1.1.9 1.8 1.6 2 .2-2.6.3-5.2 1.3-7.2Z"/></svg>
            <span class="agwn__fact-copy">
              <strong>{{ section.settings.fact_1_title }}</strong>
              {%- if section.settings.fact_1_text != blank -%}<span>{{ section.settings.fact_1_text }}</span>{%- endif -%}
            </span>
          </li>
        {%- endif -%}
        {%- if section.settings.fact_2_title != blank -%}
          <li class="agwn__fact">
            <svg class="agwn__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3.5 8 12 3.5 20.5 8v8L12 20.5 3.5 16V8Z"/><path d="M3.5 8 12 12.5 20.5 8"/><path d="M12 12.5v8"/></svg>
            <span class="agwn__fact-copy">
              <strong>{{ section.settings.fact_2_title }}</strong>
              {%- if section.settings.fact_2_text != blank -%}<span>{{ section.settings.fact_2_text }}</span>{%- endif -%}
            </span>
          </li>
        {%- endif -%}
        <li class="agwn__fact{% if offer_on %} agwn__fact--offer{% endif %}">
          <svg class="agwn__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3.5 12.2V4.5h7.7l9.3 9.3-7.7 7.7-9.3-9.3Z"/><path d="M7.7 8.700h.01"/></svg>
          <span class="agwn__fact-copy">
            {%- if offer_on -%}
              <strong>Free on orders ${{ section.settings.free_over }}+</strong>
              {%- if section.settings.offer_text != blank -%}<span>{{ section.settings.offer_text }}</span>{%- endif -%}
            {%- else -%}
              <strong>{{ hp.price | money }} per order</strong>
              <span>One covers the whole box. Add it in your cart.</span>
            {%- endif -%}
          </span>
        </li>
      </ul>

      {%- if section.settings.link_label != blank and link != blank -%}
        <a class="agwn__link" href="{{ link }}">{{ section.settings.link_label }} <span aria-hidden="true">&rarr;</span></a>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  /* Horizon's .section does not consume the padding variables; apply them here. */
  .agwn {
    padding-block-start: var(--padding-block-start, 36px);
    padding-block-end: var(--padding-block-end, 36px);
  }
  /* The grid lives on an inner wrapper: .section is already a grid of its own. */
  .agwn__grid {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr);
    grid-template-areas:
      'photo copy'
      'photo facts'
      'photo link';
    column-gap: 40px;
    row-gap: 18px;
    align-items: start;
  }
  .agwn__grid--nophoto {
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: 'copy' 'facts' 'link';
  }
  .agwn__photo {
    grid-area: photo;
    align-self: center;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 4px;
    background: #FBF8F2;
  }
  .agwn__photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .agwn__copy { grid-area: copy; }
  .agwn__eyebrow {
    margin: 0 0 8px;
    color: #9F582E;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .agwn__heading {
    margin: 0;
    font-family: var(--font-accent--family);
    font-weight: 400;
    font-size: clamp(24px, 3.2vw, 30px);
    line-height: 1.2;
    color: #2F2A22;
  }
  .agwn__text {
    margin: 8px 0 0;
    max-width: 52ch;
    font-size: 15px;
    line-height: 1.55;
    color: #56503F;
  }
  .agwn__facts {
    grid-area: facts;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
    border-block-start: 1px solid #DED3C2;
  }
  .agwn__fact {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 14px 16px 0 0;
  }
  .agwn__fact + .agwn__fact {
    padding-inline-start: 16px;
    border-inline-start: 1px solid #DED3C2;
  }
  .agwn__icon {
    flex: none;
    width: 22px;
    height: 22px;
    margin-block-start: 1px;
    color: #5C6B4C;
  }
  .agwn__fact-copy {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
    font-size: 13px;
    line-height: 1.45;
    color: #56503F;
  }
  .agwn__fact-copy strong {
    font-family: var(--font-accent--family);
    font-weight: 400;
    font-size: 16px;
    line-height: 1.3;
    color: #2F2A22;
  }
  .agwn__fact--offer .agwn__icon,
  .agwn__fact--offer .agwn__fact-copy strong { color: #9F582E; }
  .agwn__link {
    grid-area: link;
    justify-self: start;
    padding-block: 10px;
    margin-block: -10px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    color: #5C6B4C;
  }
  .agwn__link:hover, .agwn__link:focus { text-decoration: underline; text-underline-offset: 3px; }

  @media screen and (max-width: 749px) {
    .agwn__grid {
      grid-template-columns: 112px minmax(0, 1fr);
      grid-template-areas:
        'photo copy'
        'facts facts'
        'link link';
      column-gap: 16px;
      row-gap: 16px;
    }
    .agwn__grid--nophoto { grid-template-columns: minmax(0, 1fr); grid-template-areas: 'copy' 'facts' 'link'; }
    .agwn__text { font-size: 14px; }
    .agwn__facts { grid-template-columns: minmax(0, 1fr); }
    .agwn__fact { padding: 12px 0; }
    .agwn__fact + .agwn__fact {
      padding-inline-start: 0;
      border-inline-start: 0;
      border-block-start: 1px solid #DED3C2;
    }
    .agwn__fact:last-child { padding-block-end: 0; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Winter shipping band",
  "tag": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "paragraph", "content": "Heat pack and insulation call-out. The free-over amount and its end date must match the automatic discount 'Free Winter Heat Pack on Orders $100+' and the cart message." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Winter shipping" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Worried about winter?" },
    { "type": "text", "id": "text", "label": "One line", "default": "Our heat pack and thermal insulation keep your plants warm for up to 5 days in transit." },
    { "type": "header", "content": "Picture" },
    { "type": "product", "id": "product", "label": "Heat pack product", "info": "Used for the link, the price and the photo when no picture is chosen below." },
    { "type": "image_picker", "id": "image", "label": "Picture", "info": "Square works best. Leave empty to use the product's first photo." },
    { "type": "text", "id": "image_alt", "label": "Picture description", "default": "A shipping box lined with thermal insulation, with a heat pack inside" },
    { "type": "header", "content": "Facts" },
    { "type": "text", "id": "fact_1_title", "label": "Fact 1", "default": "Up to 5 days of warmth" },
    { "type": "text", "id": "fact_1_text", "label": "Fact 1 line", "default": "Heat packs rated for 72 to 120 hours." },
    { "type": "text", "id": "fact_2_title", "label": "Fact 2", "default": "Thermal insulation" },
    { "type": "text", "id": "fact_2_text", "label": "Fact 2 line", "default": "Wrapped around your plants to hold the heat in." },
    { "type": "header", "content": "Offer" },
    { "type": "number", "id": "free_over", "label": "Free on orders of ($)", "default": 100, "info": "0 shows the add-on's price instead." },
    { "type": "text", "id": "offer_ends", "label": "Offer ends", "default": "2027-03-31T23:59:59-04:00", "info": "After this the band shows the price again. Match the discount's end date." },
    { "type": "text", "id": "offer_text", "label": "Offer line", "default": "Add it in your cart. The discount applies at checkout." },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "See what goes in the box" },
    { "type": "url", "id": "link", "label": "Link", "info": "Leave empty to link to the heat pack product." },
    { "type": "header", "content": "Season" },
    { "type": "text", "id": "hide_after", "label": "Hide this band after", "default": "2027-03-31T23:59:59-04:00", "info": "The band stops showing after this date. Leave empty to always show." },
    { "type": "header", "content": "Section layout" },
    { "type": "color", "id": "background_color", "label": "Background", "placeholder": "Default" },
    { "type": "range", "id": "padding-block-start", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 36 },
    { "type": "range", "id": "padding-block-end", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 36 }
  ],
  "presets": [{ "name": "Winter shipping band", "category": "Promotions" }]
}
{% endschema %}
