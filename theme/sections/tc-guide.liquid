<div class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"></div>

<div
  class="section section--page-width{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %} agtc"
  data-agtc
  style="--padding-block-start: {{ section.settings.padding-block-start }}px; --padding-block-end: {{ section.settings.padding-block-end }}px;"
>
  <header class="agtc__hero{% if section.settings.hero_image != blank %} agtc__hero--with-image{% endif %}">
    <div class="agtc__hero-copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="agtc__eyebrow" style="--i: 0;">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h1 class="agtc__title" style="--i: 1;">{% if section.settings.heading != blank %}{{ section.settings.heading }}{% else %}{{ page.title }}{% endif %}</h1>
      {%- if page.content != blank -%}
        <div class="agtc__lead rte" style="--i: 2;">{{ page.content }}</div>
      {%- endif -%}
    </div>
    {%- if section.settings.hero_image != blank -%}
      <figure class="agtc__hero-figure">
        <span class="agtc__hero-rise" style="--i: 1;">
          {{ section.settings.hero_image | image_url: width: 900 | image_tag: widths: '300, 450, 600, 900', sizes: '(max-width: 749px) 70vw, 360px', loading: 'eager', alt: '' }}
        </span>
      </figure>
    {%- endif -%}
  </header>

  <div class="agtc__body">
    <span class="agtc__spine" aria-hidden="true"></span>
    {%- liquid
      assign open = ''
      assign step_n = 0
      assign chapter_n = 0
      assign gi = 0
    -%}
    {%- for block in section.blocks -%}
      {%- liquid
        assign kind = block.type
        if kind != open
          case open
            when 'step'
              echo '</ol>'
            when 'card', 'faq', 'link', 'stat', 'tile'
              echo '</div>'
          endcase
          case kind
            when 'step'
              echo '<ol class="agtc__steps">'
              assign step_n = 0
            when 'card'
              echo '<div class="agtc__cards">'
            when 'faq'
              echo '<div class="agtc__faq">'
            when 'link'
              echo '<div class="agtc__links">'
            when 'stat'
              echo '<div class="agtc__stats">'
            when 'tile'
              echo '<div class="agtc__tiles">'
          endcase
          assign open = kind
          assign gi = 0
        else
          assign gi = gi | plus: 1
        endif
      -%}

      {%- case block.type -%}
        {%- when 'chapter' -%}
          {%- assign chapter_n = chapter_n | plus: 1 -%}
          <section class="agtc__chapter" data-reveal {{ block.shopify_attributes }}>
            <span class="agtc__mark agtc__mark--node" aria-hidden="true"><span class="agtc__node">{{ chapter_n }}</span></span>
            {%- if block.settings.eyebrow != blank -%}<p class="agtc__eyebrow">{{ block.settings.eyebrow }}</p>{%- endif -%}
            {%- if block.settings.heading != blank -%}<h2 class="agtc__h2">{{ block.settings.heading }}</h2>{%- endif -%}
            {%- if block.settings.text != blank -%}<div class="agtc__text rte">{{ block.settings.text }}</div>{%- endif -%}
          </section>

        {%- when 'step' -%}
          {%- assign step_n = step_n | plus: 1 -%}
          {%- assign icon_key = block.settings.icon | append: '|' -%}
          <li class="agtc__step" data-reveal style="--i: {{ gi }};" {{ block.shopify_attributes }}>
            <span class="agtc__mark agtc__step-mark">
              {%- if block.settings.icon != 'none' and icon_paths contains icon_key -%}
                {%- assign icon_svg = icon_paths | split: icon_key | last | split: '
' | first -%}
                <svg class="agtc__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">{{ icon_svg }}</svg>
                <span class="agtc__step-n agtc__step-n--badge">{{ step_n }}</span>
              {%- else -%}
                <span class="agtc__step-n">{{ step_n }}</span>
              {%- endif -%}
            </span>
            <div class="agtc__step-body">
              {%- if block.settings.title != blank -%}<h3 class="agtc__h3">{{ block.settings.title }}</h3>{%- endif -%}
              {%- if block.settings.text != blank -%}<div class="agtc__text rte">{{ block.settings.text }}</div>{%- endif -%}
            </div>
          </li>

        {%- when 'stat' -%}
          <div class="agtc__stat" data-reveal style="--i: {{ gi }};" {{ block.shopify_attributes }}>
            <span class="agtc__stat-value" data-count="{{ block.settings.value | escape }}">{{ block.settings.value }}</span>
            <span class="agtc__stat-label">{{ block.settings.label }}</span>
          </div>

        {%- when 'tile' -%}
          {%- assign icon_key = block.settings.icon | append: '|' -%}
          <div class="agtc__tile" data-reveal style="--i: {{ gi }};" {{ block.shopify_attributes }}>
            {%- if block.settings.icon != 'none' and icon_paths contains icon_key -%}
              {%- assign icon_svg = icon_paths | split: icon_key | last | split: '
' | first -%}
              <span class="agtc__tile-icon"><svg class="agtc__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">{{ icon_svg }}</svg></span>
            {%- endif -%}
            <span class="agtc__tile-title">{{ block.settings.title }}</span>
            {%- if block.settings.text != blank -%}<span class="agtc__tile-text">{{ block.settings.text }}</span>{%- endif -%}
          </div>

        {%- when 'card' -%}
          <article class="agtc__card{% if block.settings.featured %} agtc__card--featured{% endif %}" data-reveal style="--i: {{ gi }};" {{ block.shopify_attributes }}>
            {%- if block.settings.eyebrow != blank -%}<p class="agtc__card-eyebrow">{{ block.settings.eyebrow }}</p>{%- endif -%}
            {%- if block.settings.title != blank -%}<h3 class="agtc__h3">{{ block.settings.title }}</h3>{%- endif -%}
            {%- if block.settings.text != blank -%}<div class="agtc__text rte">{{ block.settings.text }}</div>{%- endif -%}
            {%- if block.settings.link_label != blank and block.settings.link != blank -%}
              <a class="agtc__cta{% unless block.settings.featured %} agtc__cta--ghost{% endunless %}" href="{{ block.settings.link }}">{{ block.settings.link_label }}</a>
            {%- endif -%}
          </article>

        {%- when 'faq' -%}
          <details class="agtc__q" data-reveal style="--i: {{ gi }};" {{ block.shopify_attributes }}>
            <summary class="agtc__q-summary">{{ block.settings.question }}<span class="agtc__q-icon" aria-hidden="true"></span></summary>
            <div class="agtc__text agtc__q-answer rte">{{ block.settings.answer }}</div>
          </details>

        {%- when 'link' -%}
          <a class="agtc__link" href="{{ block.settings.link }}" data-reveal style="--i: {{ gi }};" {{ block.shopify_attributes }}>
            <span class="agtc__link-title">{{ block.settings.title }}</span>
            {%- if block.settings.text != blank -%}<span class="agtc__link-text">{{ block.settings.text }}</span>{%- endif -%}
            <span class="agtc__link-arrow" aria-hidden="true">&rarr;</span>
          </a>

        {%- when 'cta' -%}
          <div class="agtc__band" data-reveal {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}<h2 class="agtc__h2 agtc__band-title">{{ block.settings.heading }}</h2>{%- endif -%}
            {%- if block.settings.text != blank -%}<div class="agtc__text rte">{{ block.settings.text }}</div>{%- endif -%}
            <div class="agtc__band-actions">
              {%- if block.settings.primary_label != blank -%}<a class="agtc__cta" href="{{ block.settings.primary_link }}">{{ block.settings.primary_label }}</a>{%- endif -%}
              {%- if block.settings.secondary_label != blank -%}<a class="agtc__cta agtc__cta--ghost" href="{{ block.settings.secondary_link }}">{{ block.settings.secondary_label }}</a>{%- endif -%}
            </div>
          </div>
      {%- endcase -%}
    {%- endfor -%}
    {%- liquid
      case open
        when 'step'
          echo '</ol>'
        when 'card', 'faq', 'link', 'stat', 'tile'
          echo '</div>'
      endcase
    -%}
  </div>
</div>

<script>
  (function () {
    var root = document.querySelector('[data-agtc]');
    if (!root || root.hasAttribute('data-agtc-ready')) return;
    root.setAttribute('data-agtc-ready', '');
    var marks = root.querySelectorAll('.agtc__mark');
    var reveals = root.querySelectorAll('[data-reveal]');
    var still = window.matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window);
    if (still) {
      for (var s = 0; s < marks.length; s++) marks[s].classList.add('is-lit');
      return;
    }
    root.classList.add('agtc--js');

    /* reveal once, when an element enters the lower part of the viewport */
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (!e.isIntersecting) return;
        e.target.classList.add('is-in');
        io.unobserve(e.target);
        countUp(e.target.querySelector('[data-count]'));
      });
    }, { rootMargin: '0px 0px -10% 0px', threshold: 0.05 });
    for (var r = 0; r < reveals.length; r++) io.observe(reveals[r]);

    /* big numbers count up from zero: "30 days" -> 0..30 days, "$14.99" -> $0.00..$14.99 */
    function countUp(el) {
      if (!el) return;
      var m = el.getAttribute('data-count').match(/^([^0-9]*)([0-9][0-9,]*(?:\.[0-9]+)?)(.*)$/);
      if (!m) return;
      var end = parseFloat(m[2].replace(/,/g, '')), dec = (m[2].split('.')[1] || '').length, t0 = null, dur = 1100;
      function tick(t) {
        if (t0 === null) t0 = t;
        var k = Math.min(1, (t - t0) / dur); k = 1 - Math.pow(1 - k, 3);
        el.textContent = m[1] + (end * k).toFixed(dec) + m[3];
        if (k < 1) requestAnimationFrame(tick);
      }
      requestAnimationFrame(tick);
    }

    /* the thread: --p is how far down the body the reading line has reached; marks above it are lit */
    var body = root.querySelector('.agtc__body');
    var figure = root.querySelector('.agtc__hero-figure');
    var queued = false;
    function frame() {
      queued = false;
      var line = window.innerHeight * 0.62;
      var b = body.getBoundingClientRect();
      var p = (line - b.top) / b.height;
      body.style.setProperty('--p', (p < 0 ? 0 : p > 1 ? 1 : p).toFixed(4));
      for (var i = 0; i < marks.length; i++) {
        var mr = marks[i].getBoundingClientRect();
        marks[i].classList.toggle('is-lit', mr.top + mr.height / 2 < line);
      }
      if (figure) {
        var top = root.getBoundingClientRect().top;
        figure.style.setProperty('--y', (top < 0 ? -top * 0.1 : 0).toFixed(1) + 'px');
      }
    }
    function request() { if (!queued) { queued = true; requestAnimationFrame(frame); } }
    /* Scroll events do not bubble, and on desktop the theme may scroll an inner container rather
       than the window (seen on Safari for Mac), so listen in the capture phase on the document:
       that hears a scroll from any element. */
    document.addEventListener('scroll', request, { capture: true, passive: true });
    window.addEventListener('resize', request);
    /* Second line of defence: marks also watch the reading line themselves, so they light up
       even if no scroll event ever reaches us. */
    var lineIo = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        e.target.classList.toggle('is-lit', e.isIntersecting || e.boundingClientRect.top < 0);
      });
      request();
    }, { rootMargin: '0px 0px -38% 0px', threshold: 0 });
    for (var k = 0; k < marks.length; k++) lineIo.observe(marks[k]);
    /* Third: a per-frame position check that needs no event at all. One getBoundingClientRect
       per frame; it does nothing while the body has not moved. */
    var lastTop = null;
    function poll() {
      var t = body.getBoundingClientRect().top;
      if (t !== lastTop) { lastTop = t; frame(); }
      requestAnimationFrame(poll);
    }
    requestAnimationFrame(poll);
  })();
</script>

{% stylesheet %}
  .agtc {
    padding-block-start: var(--padding-block-start, 56px);
    padding-block-end: var(--padding-block-end, 72px);
    --agtc-g: 72px;  /* gutter the thread lives in */
    --agtc-x: 24px;  /* where the thread runs, from the left edge */
    --agtc-m: 48px;  /* step mark size */
    --agtc-ease: cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  /* Horizon places section children in its centre grid track; width: 100% + min-width: 0 keeps
     a grid child from sizing to its max-content and overflowing a phone. */
  .agtc > * { width: 100%; max-width: 760px; min-width: 0; margin-inline: auto; box-sizing: border-box; }

  /* ---- hero ---- */
  .agtc__eyebrow {
    margin: 0 0 12px; color: #B4693C;
    font-size: 11px; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase;
  }
  .agtc__title {
    margin: 0; font-family: var(--font-accent--family); font-weight: 400;
    font-size: clamp(34px, 5.5vw, 50px); line-height: 1.08; text-wrap: balance;
  }
  .agtc__lead { margin-block-start: 20px; font-size: 17px; line-height: 1.6; max-width: 46ch; color: var(--color-foreground-muted, #56503F); }
  .agtc__lead > :first-child { margin-block-start: 0; }
  .agtc__lead > :last-child { margin-block-end: 0; }
  .agtc__hero { padding-block-end: 8px; }
  .agtc__hero--with-image { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: clamp(24px, 4vw, 48px); align-items: center; }
  .agtc__hero-figure { margin: 0; transform: translateY(var(--y, 0)); will-change: transform; }
  .agtc__hero-rise { display: block; }
  .agtc__hero-figure img { display: block; width: 100%; height: auto; animation: agtc-float 8s ease-in-out infinite alternate; }
  @keyframes agtc-float { from { transform: translateY(0) rotate(0); } to { transform: translateY(-10px) rotate(0.8deg); } }
  .agtc--js .agtc__hero-copy > *, .agtc--js .agtc__hero-rise {
    animation: agtc-rise 0.9s var(--agtc-ease) both; animation-delay: calc(var(--i, 0) * 130ms);
  }
  @keyframes agtc-rise { from { opacity: 0; transform: translateY(22px); } to { opacity: 1; transform: none; } }

  /* ---- the thread ---- */
  .agtc__body { position: relative; padding-inline-start: var(--agtc-g); padding-block-start: clamp(40px, 6vw, 64px); --p: 1; }
  .agtc__spine {
    position: absolute; top: calc(clamp(40px, 6vw, 64px) + 14px); bottom: 0; left: calc(var(--agtc-x) - 1px);
    width: 2px; background: #DED3C2; pointer-events: none;
  }
  .agtc__spine::after {
    content: ""; position: absolute; left: 0; top: 0; width: 100%;
    height: calc(var(--p) * 100%); background: #5C6B4C; transition: height 0.25s linear;
  }
  .agtc__mark { position: relative; }
  .agtc__mark::after {
    content: ""; position: absolute; inset: -2px; border-radius: 50%; border: 2px solid #5C6B4C; opacity: 0; pointer-events: none;
  }
  .agtc--js .agtc__mark.is-lit::after { animation: agtc-pulse 0.8s ease-out; }
  @keyframes agtc-pulse { from { opacity: 0.6; transform: scale(1); } to { opacity: 0; transform: scale(1.9); } }

  /* ---- reveals ---- */
  .agtc--js [data-reveal] {
    opacity: 0; transform: translateY(26px);
    transition: opacity 0.8s var(--agtc-ease), transform 0.8s var(--agtc-ease);
    transition-delay: min(calc(var(--i, 0) * 80ms), 480ms);
  }
  .agtc--js [data-reveal].is-in { opacity: 1; transform: none; }

  /* ---- chapters: a numbered node on the thread ---- */
  .agtc__chapter { position: relative; margin-block-start: clamp(48px, 8vw, 80px); }
  .agtc__spine + .agtc__chapter { margin-block-start: 0; }
  .agtc__chapter .agtc__eyebrow { line-height: 28px; margin: 0 0 6px; }
  .agtc__mark--node { position: absolute; top: 0; left: calc(var(--agtc-x) - var(--agtc-g)); width: 28px; height: 28px; transform: translateX(-50%); display: block; }
  .agtc__node {
    display: inline-flex; align-items: center; justify-content: center; width: 28px; height: 28px; box-sizing: border-box;
    border-radius: 50%; background: #FBF8F2; border: 2px solid #DED3C2; color: #56503F;
    font-family: var(--font-accent--family); font-size: 13px; line-height: 1;
    transition: background-color 0.4s ease, border-color 0.4s ease, color 0.4s ease;
  }
  .agtc__mark.is-lit .agtc__node { background: #5C6B4C; border-color: #5C6B4C; color: #FBF8F2; }

  .agtc__h2 {
    margin: 0; font-family: var(--font-accent--family); font-weight: 400;
    font-size: clamp(26px, 3.8vw, 34px); line-height: 1.18; text-wrap: balance;
  }
  .agtc__h3 { margin: 0; font-family: var(--font-accent--family); font-weight: 400; font-size: 21px; line-height: 1.25; }
  .agtc__text { margin-block-start: 10px; font-size: 15px; line-height: 1.6; color: var(--color-foreground-muted, #56503F); max-width: 52ch; }
  .agtc__text > :first-child { margin-block-start: 0; }
  .agtc__text > :last-child { margin-block-end: 0; }
  .agtc__text ul { padding-inline-start: 1.2em; }
  .agtc__text a { color: inherit; text-decoration: underline; text-underline-offset: 3px; }
  .agtc__chapter + .agtc__steps, .agtc__chapter + .agtc__cards, .agtc__chapter + .agtc__faq,
  .agtc__chapter + .agtc__links, .agtc__chapter + .agtc__stats, .agtc__chapter + .agtc__tiles { margin-block-start: 26px; }

  /* ---- steps: marks sit on the thread itself ---- */
  .agtc__steps { margin: 0; padding: 0; list-style: none; }
  .agtc__step {
    display: grid; grid-template-columns: var(--agtc-m) 1fr; column-gap: calc(var(--agtc-g) - var(--agtc-m));
    margin-inline-start: calc(-1 * var(--agtc-g)); align-items: start; padding-block-end: 24px;
  }
  .agtc__step:last-child { padding-block-end: 0; }
  .agtc__step-mark {
    display: inline-flex; align-items: center; justify-content: center; box-sizing: border-box;
    width: var(--agtc-m); height: var(--agtc-m); border-radius: 50%;
    background: #FBF8F2; border: 2px solid #DED3C2; color: #5C6B4C;
    transition: background-color 0.4s ease, border-color 0.4s ease, color 0.4s ease;
  }
  .agtc__step-mark.is-lit { background: #5C6B4C; border-color: #5C6B4C; color: #FBF8F2; }
  .agtc__icon { display: block; width: 22px; height: 22px; }
  .agtc__step-n { font-family: var(--font-accent--family); font-size: 18px; line-height: 1; }
  .agtc__step-n--badge {
    position: absolute; top: -5px; right: -5px; width: 20px; height: 20px; border-radius: 50%;
    display: inline-flex; align-items: center; justify-content: center;
    background: #B4693C; color: #FBF8F2; font-family: var(--font-body--family); font-size: 11px; font-weight: 600;
  }
  .agtc__step-body { padding-block-start: 10px; }
  .agtc__step .agtc__text { margin-block-start: 4px; }

  /* ---- stats: big numbers that count up ---- */
  .agtc__stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(140px, 100%), 1fr)); gap: 12px; }
  .agtc__stat { padding: 22px 14px; border-radius: 4px; background: #F2EBDE; text-align: center; }
  .agtc__stat-value { display: block; font-family: var(--font-accent--family); font-size: clamp(28px, 3.8vw, 36px); line-height: 1.05; font-variant-numeric: tabular-nums; }
  .agtc__stat-label { display: block; margin-block-start: 8px; font-size: 11px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-foreground-muted, #56503F); }

  /* ---- tiles: icon, title, one line ---- */
  .agtc__tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(118px, 100%), 1fr)); gap: 10px; }
  .agtc__tile { padding: 18px 12px; border: 1px solid #DED3C2; border-radius: 4px; background: #FBF8F2; text-align: center; }
  .agtc--js .agtc__tile[data-reveal] { transform: translateY(18px) scale(0.96); }
  .agtc--js .agtc__tile[data-reveal].is-in { transform: none; }
  .agtc__tile-icon { display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; border-radius: 50%; background: #E8EDE1; color: #5C6B4C; margin-block-end: 10px; }
  .agtc__tile-title { display: block; font-weight: 600; font-size: 14px; line-height: 1.3; }
  .agtc__tile-text { display: block; margin-block-start: 5px; font-size: 12.5px; line-height: 1.45; color: var(--color-foreground-muted, #56503F); }

  /* ---- cards ---- */
  .agtc__cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(200px, 100%), 1fr)); gap: 14px; }
  .agtc__card {
    padding: 24px 22px; border: 1px solid #DED3C2; border-radius: 4px; background: #FBF8F2;
    display: flex; flex-direction: column; gap: 10px;
  }
  .agtc__card--featured { background: #5C6B4C; border-color: #5C6B4C; color: #FBF8F2; }
  .agtc__card--featured .agtc__text, .agtc__card--featured .agtc__card-eyebrow { color: rgb(251 248 242 / 0.85); }
  .agtc__card .agtc__text { margin-block-start: 0; flex: 1; }
  .agtc__card-eyebrow { margin: 0; font-size: 10px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: #B4693C; }
  .agtc__card .agtc__cta { align-self: flex-start; margin-block-start: 6px; }

  /* ---- faq ---- */
  .agtc__faq { border-top: 1px solid #DED3C2; }
  .agtc__q { border-bottom: 1px solid #DED3C2; }
  .agtc__q-summary {
    display: flex; justify-content: space-between; align-items: center; gap: 16px;
    padding: 16px 0; cursor: pointer; list-style: none; font-size: 16px; font-weight: 500;
  }
  .agtc__q-summary::-webkit-details-marker { display: none; }
  .agtc__q-icon { position: relative; flex: 0 0 18px; height: 18px; }
  .agtc__q-icon::before, .agtc__q-icon::after {
    content: ""; position: absolute; inset: 50% auto auto 50%; background: currentColor;
    width: 14px; height: 1.5px; transform: translate(-50%, -50%); transition: transform 0.2s ease;
  }
  .agtc__q-icon::after { transform: translate(-50%, -50%) rotate(90deg); }
  .agtc__q[open] .agtc__q-icon::after { transform: translate(-50%, -50%) rotate(0); }
  .agtc__q-answer { margin: 0; padding-block-end: 18px; }

  /* ---- links ---- */
  .agtc__links { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(200px, 100%), 1fr)); gap: 10px; }
  .agtc__link {
    position: relative; display: block; padding: 16px 44px 16px 16px; border: 1px solid #DED3C2;
    border-radius: 4px; text-decoration: none; color: inherit; background: #FBF8F2;
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }
  .agtc__link:hover, .agtc__link:focus { border-color: #5C6B4C; background: #F2EBDE; }
  .agtc__link-title { display: block; font-weight: 600; font-size: 15px; }
  .agtc__link-text { display: block; margin-block-start: 4px; font-size: 13px; color: var(--color-foreground-muted, #56503F); }
  .agtc__link-arrow { position: absolute; right: 16px; top: 50%; transform: translateY(-50%); color: #5C6B4C; }

  /* ---- cta band: spans the full column and caps the thread ---- */
  .agtc__band {
    position: relative; margin-block-start: clamp(48px, 8vw, 80px); margin-inline-start: calc(-1 * var(--agtc-g));
    padding: clamp(28px, 5vw, 44px); border-radius: 4px; background: #F2EBDE; text-align: center;
  }
  .agtc__band .agtc__text { max-width: 44ch; margin-inline: auto; }
  .agtc__band-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin-block-start: 22px; }
  .agtc__cta {
    display: inline-block; padding: 14px 28px; border-radius: 2px; background: #5C6B4C; color: #FBF8F2;
    font-size: 12px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; text-decoration: none;
    border: 1px solid #5C6B4C; transition: background-color 0.2s ease, color 0.2s ease;
  }
  .agtc__cta:hover, .agtc__cta:focus { background: #4A573D; border-color: #4A573D; color: #FBF8F2; }
  .agtc__cta--ghost { background: transparent; color: inherit; border-color: currentColor; }
  .agtc__cta--ghost:hover, .agtc__cta--ghost:focus { background: #5C6B4C; border-color: #5C6B4C; color: #FBF8F2; }
  .agtc__card--featured .agtc__cta { background: #FBF8F2; border-color: #FBF8F2; color: #2F2A22; }
  .agtc__card--featured .agtc__cta:hover { background: #F2EBDE; border-color: #F2EBDE; color: #2F2A22; }

  @media screen and (max-width: 749px) {
    .agtc { --agtc-g: 56px; --agtc-x: 20px; --agtc-m: 40px; }
    .agtc__hero--with-image { grid-template-columns: 1fr; }
    .agtc__hero-figure { order: -1; width: 60%; max-width: 240px; margin-inline: auto; }
    .agtc__tiles { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .agtc__tile:last-child:nth-child(odd) { grid-column: span 2; }
    .agtc__stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .agtc__step-n { font-size: 16px; }
    .agtc__icon { width: 19px; height: 19px; }
    .agtc__h3 { font-size: 19px; }
  }
  @media screen and (max-width: 560px) {
    .agtc__band-actions .agtc__cta { width: 100%; text-align: center; }
  }
  @media (prefers-reduced-motion: reduce) {
    .agtc__hero-figure img, .agtc__hero-copy > *, .agtc__hero-rise, .agtc__mark::after { animation: none; }
    .agtc__hero-figure { transform: none; }
    .agtc__spine::after, .agtc__node, .agtc__step-mark { transition: none; }
  }
{% endstylesheet %}

