{%- doc -%}
  AgaPlantz — "Why collectors choose AgaPlantz" on the home page, rebuilt 7 Nov 2026.
  Heading left, then one card per reason block: a numbered Lora eyebrow, a moss icon disc,
  a title and one line. Four across on desktop, two by two on a phone. Icons are an inline
  SVG set keyed by name, so there is nothing to upload.
{%- enddoc -%}

{%- liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
-%}

<div class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"></div>

<div
  class="section section--page-width{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %} agwy"
  style="--padding-block-start: {{ section.settings.padding-block-start }}px; --padding-block-end: {{ section.settings.padding-block-end }}px;"
>
  <div class="agwy__head">
    <div class="agwy__copy">
      {%- if section.settings.eyebrow != blank -%}<p class="agwy__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="agwy__heading">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="agwy__text">{{ section.settings.text }}</p>{%- endif -%}
    </div>
  </div>

  {%- if section.blocks.size > 0 -%}
    <ul class="agwy__grid agwy__grid--{{ section.blocks.size }}">
      {%- for block in section.blocks -%}
        <li class="agwy__card" {{ block.shopify_attributes }}>
          {%- if section.settings.show_numbers -%}
            <span class="agwy__num" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          {%- endif -%}
          <span class="agwy__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" width="22" height="22">
              {%- case block.settings.icon -%}
                {%- when 'plant' -%}
                  <path d="M12 21v-8"/><path d="M12 13c0-4-3-6-7-6 0 4 3 6 7 6Z"/><path d="M12 11c0-4 3-7 7-7 0 4-3 7-7 7Z"/><path d="M7 21h10"/>
                {%- when 'box' -%}
                  <path d="m12 3 8 4.5v9L12 21l-8-4.5v-9L12 3Z"/><path d="M4 7.5 12 12l8-4.5"/><path d="M12 12v9"/>
                {%- when 'truck' -%}
                  <path d="M3 7h11v9H3z"/><path d="M14 10h4l3 3v3h-7z"/><circle cx="7" cy="18" r="1.8"/><circle cx="17" cy="18" r="1.8"/>
                {%- when 'leaf' -%}
                  <path d="M5 19c0-8 5-13 14-14-1 9-6 14-14 14Z"/><path d="M5 19c3-4 6-7 10-10"/>
                {%- when 'shield' -%}
                  <path d="M12 3 5 5.5v5.3c0 4.6 3 8.3 7 9.7 4-1.4 7-5.1 7-9.7V5.5L12 3Z"/><path d="m9 12 2 2 4-4.5"/>
                {%- when 'flask' -%}
                  <path d="M10 3h4"/><path d="M10 3v6l-5.5 9.5A1.5 1.5 0 0 0 5.8 21h12.4a1.5 1.5 0 0 0 1.3-2.5L14 9V3"/><path d="M7.5 15h9"/>
                {%- when 'thermometer' -%}
                  <path d="M10 14.5V5a2 2 0 1 1 4 0v9.5a3.5 3.5 0 1 1-4 0Z"/><path d="M12 9v8"/>
                {%- when 'pin' -%}
                  <path d="M12 21s6-6 6-11a6 6 0 0 0-12 0c0 5 6 11 6 11Z"/><circle cx="12" cy="10" r="2.2"/>
                {%- when 'star' -%}
                  <path d="m12 3 2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1L3.2 9.5l6.1-.9L12 3Z"/>
                {%- when 'chat' -%}
                  <path d="M4 5h16v11H9l-5 4V5Z"/><path d="M8 9h8"/><path d="M8 12.5h5"/>
                {%- else -%}
                  <circle cx="12" cy="12" r="8"/><path d="m9 12 2 2 4-4.5"/>
              {%- endcase -%}
            </svg>
          </span>
          <h3 class="agwy__title">{{ block.settings.title }}</h3>
          {%- if block.settings.text != blank -%}<p class="agwy__line">{{ block.settings.text }}</p>{%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
</div>

{% stylesheet %}
  .agwy {
    padding-block-start: var(--padding-block-start, 64px);
    padding-block-end: var(--padding-block-end, 64px);
  }
  .agwy__head { margin-block-end: 28px; }
  .agwy__copy { max-width: 56ch; }
  .agwy__eyebrow {
    margin: 0 0 8px;
    color: #B4693C;
    font-family: var(--font-body--family);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .agwy__heading {
    margin: 0;
    font-family: var(--font-accent--family);
    font-weight: 400;
    font-size: clamp(26px, 3.4vw, 34px);
    line-height: 1.15;
    text-wrap: pretty;
  }
  .agwy__text {
    margin: 10px 0 0;
    font-family: var(--font-body--family);
    font-size: 15px;
    line-height: 1.55;
    color: #56503F;
  }
  .agwy__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
  }
  .agwy__grid--3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .agwy__grid--2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .agwy__grid--5, .agwy__grid--6 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .agwy__card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 22px 20px 22px;
    background: #FBF8F2;
    border: 1px solid #DED3C2;
    border-radius: 4px;
  }
  .agwy__num {
    position: absolute;
    top: 16px;
    right: 18px;
    font-family: var(--font-accent--family);
    font-size: 14px;
    letter-spacing: 0.06em;
    color: #B4693C;
  }
  .agwy__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: #5C6B4C;
    color: #FBF8F2;
    margin-bottom: 4px;
  }
  .agwy__title {
    margin: 0;
    font-family: var(--font-accent--family);
    font-weight: 400;
    font-size: 19px;
    line-height: 1.25;
    color: #2F2A22;
  }
  .agwy__line {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: 14px;
    line-height: 1.5;
    color: #56503F;
  }
  @media screen and (max-width: 749px) {
    .agwy__head { margin-block-end: 20px; }
    .agwy__grid, .agwy__grid--3, .agwy__grid--5, .agwy__grid--6 { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
    .agwy__card { padding: 16px 14px 16px; gap: 8px; }
    .agwy__num { top: 12px; right: 12px; font-size: 12px; }
    .agwy__icon { width: 38px; height: 38px; }
    .agwy__icon svg { width: 19px; height: 19px; }
    .agwy__title { font-size: 16px; }
    .agwy__line { font-size: 13px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Why AgaPlantz",
  "tag": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The AgaPlantz way" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why collectors choose AgaPlantz" },
    { "type": "text", "id": "text", "label": "One line (optional)" },
    { "type": "checkbox", "id": "show_numbers", "label": "Number the cards (01, 02…)", "default": true },
    { "type": "header", "content": "Section layout" },
    { "type": "color", "id": "background_color", "label": "Background", "placeholder": "Default" },
    { "type": "range", "id": "padding-block-start", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding-block-end", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 64 }
  ],
  "blocks": [
    {
      "type": "reason",
      "name": "Reason",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "options": [
          { "value": "plant", "label": "Sprout" }, { "value": "leaf", "label": "Leaf" }, { "value": "box", "label": "Box" },
          { "value": "truck", "label": "Truck" }, { "value": "shield", "label": "Shield" }, { "value": "flask", "label": "Lab flask" },
          { "value": "thermometer", "label": "Thermometer" }, { "value": "pin", "label": "Map pin" }, { "value": "star", "label": "Star" },
          { "value": "chat", "label": "Chat" } ], "default": "plant" },
        { "type": "text", "id": "title", "label": "Title", "default": "Rooted before it ships" },
        { "type": "textarea", "id": "text", "label": "One line", "default": "Established and acclimated in our greenhouse, never straight from the lab." }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Why AgaPlantz",
      "category": "Text",
      "blocks": [
        { "type": "reason", "settings": { "icon": "plant", "title": "Rooted before it ships", "text": "Established and acclimated in our greenhouse, never straight from the lab." } },
        { "type": "reason", "settings": { "icon": "box", "title": "Packed for the season", "text": "Insulated boxes and heat packs right through the Canadian winter." } },
        { "type": "reason", "settings": { "icon": "truck", "title": "Shipped Canada-wide", "text": "Tracked delivery to every province, with local pickup in Brampton." } },
        { "type": "reason", "settings": { "icon": "leaf", "title": "Pest-free by design", "text": "Lab-propagated stock means no thrips, no mealybugs, no quarantine." } }
      ]
    }
  ]
}
{% endschema %}
