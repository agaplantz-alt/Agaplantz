{%- doc -%}
  AgaPlantz — "Why collectors choose AgaPlantz" on the home page. Rebuilt 7 Nov 2026 as
  numbered cards, then made smaller and quieter the same night on the owner's note
  ("smaller … luxurious, but it should not complicate things"). One small heading, then a
  single hairline-ruled row: each reason is a thin-line icon, a Lora title and one short
  line, with a vertical rule between items on desktop and a 2×2 grid on a phone. No cards,
  no fills, no numbers. Icons are an inline SVG set keyed by name.
{%- enddoc -%}

{%- liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
  assign photo = section.settings.image
  if photo == blank and section.settings.product != blank
    assign photo = section.settings.product.featured_image
  endif
  assign photo_url = section.settings.image_link
  if photo_url == blank and section.settings.product != blank
    assign photo_url = section.settings.product.url
  endif
-%}

<div class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"></div>

<div
  class="section section--page-width{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %} agwy"
  style="--padding-block-start: {{ section.settings.padding-block-start }}px; --padding-block-end: {{ section.settings.padding-block-end }}px;"
>
  <div class="agwy__grid{% if photo %} agwy__grid--photo agwy__grid--{{ section.settings.image_position }}{% endif %}">
  {%- if photo -%}
    <div class="agwy__figure">
      {%- if photo_url != blank -%}<a class="agwy__photo" href="{{ photo_url }}" aria-label="{{ section.settings.image_caption | default: photo.alt | escape }}">{%- else -%}<span class="agwy__photo">{%- endif -%}
        {{ photo | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 40vw, 100vw', widths: '400, 600, 800, 1200', alt: photo.alt }}
        {%- if section.settings.image_caption != blank -%}<span class="agwy__caption">{{ section.settings.image_caption }}</span>{%- endif -%}
      {%- if photo_url != blank -%}</a>{%- else -%}</span>{%- endif -%}
    </div>
  {%- endif -%}
  <div class="agwy__content">
  <div class="agwy__head">
    {%- if section.settings.eyebrow != blank -%}<p class="agwy__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2 class="agwy__heading">{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}<p class="agwy__text">{{ section.settings.text }}</p>{%- endif -%}
  </div>

  {%- if section.blocks.size > 0 -%}
    <ul class="agwy__row agwy__row--{{ section.blocks.size }}">
      {%- for block in section.blocks -%}
        <li class="agwy__item" {{ block.shopify_attributes }}>
          <span class="agwy__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" width="26" height="26">
              {%- case block.settings.icon -%}
                {%- when 'plant' -%}
                  <path d="M12 21v-8"/><path d="M12 13c0-4-3-6-7-6 0 4 3 6 7 6Z"/><path d="M12 11c0-4 3-7 7-7 0 4-3 7-7 7Z"/><path d="M7 21h10"/>
                {%- when 'box' -%}
                  <path d="m12 3 8 4.5v9L12 21l-8-4.5v-9L12 3Z"/><path d="M4 7.5 12 12l8-4.5"/><path d="M12 12v9"/>
                {%- when 'truck' -%}
                  <path d="M3 7h11v9H3z"/><path d="M14 10h4l3 3v3h-7z"/><circle cx="7" cy="18" r="1.8"/><circle cx="17" cy="18" r="1.8"/>
                {%- when 'leaf' -%}
                  <path d="M5 19c0-8 5-13 14-14-1 9-6 14-14 14Z"/><path d="M5 19c3-4 6-7 10-10"/>
                {%- when 'shield' -%}
                  <path d="M12 3 5 5.5v5.3c0 4.6 3 8.3 7 9.7 4-1.4 7-5.1 7-9.7V5.5L12 3Z"/><path d="m9 12 2 2 4-4.5"/>
                {%- when 'flask' -%}
                  <path d="M10 3h4"/><path d="M10 3v6l-5.5 9.5A1.5 1.5 0 0 0 5.8 21h12.4a1.5 1.5 0 0 0 1.3-2.5L14 9V3"/><path d="M7.5 15h9"/>
                {%- when 'thermometer' -%}
                  <path d="M10 14.5V5a2 2 0 1 1 4 0v9.5a3.5 3.5 0 1 1-4 0Z"/><path d="M12 9v8"/>
                {%- when 'pin' -%}
                  <path d="M12 21s6-6 6-11a6 6 0 0 0-12 0c0 5 6 11 6 11Z"/><circle cx="12" cy="10" r="2.2"/>
                {%- when 'star' -%}
                  <path d="m12 3 2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1L3.2 9.5l6.1-.9L12 3Z"/>
                {%- when 'chat' -%}
                  <path d="M4 5h16v11H9l-5 4V5Z"/><path d="M8 9h8"/><path d="M8 12.5h5"/>
                {%- else -%}
                  <circle cx="12" cy="12" r="8"/><path d="m9 12 2 2 4-4.5"/>
              {%- endcase -%}
            </svg>
          </span>
          <h3 class="agwy__title">{{ block.settings.title }}</h3>
          {%- if block.settings.text != blank -%}<p class="agwy__line">{{ block.settings.text }}</p>{%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
  </div>
  </div>
</div>

{% stylesheet %}
  .agwy {
    padding-block-start: var(--padding-block-start, 48px);
    padding-block-end: var(--padding-block-end, 48px);
  }
  .agwy__head { margin-block-end: 24px; max-width: 56ch; }
  .agwy__eyebrow {
    margin: 0 0 8px;
    color: #B4693C;
    font-family: var(--font-body--family);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .agwy__heading {
    margin: 0;
    font-family: var(--font-accent--family);
    font-weight: 400;
    font-size: clamp(24px, 2.6vw, 28px);
    line-height: 1.2;
    text-wrap: pretty;
  }
  .agwy__text {
    margin: 8px 0 0;
    font-family: var(--font-body--family);
    font-size: 14px;
    line-height: 1.55;
    color: #56503F;
  }
  .agwy__row {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid #CFC4B0;
    border-bottom: 1px solid #CFC4B0;
  }
  .agwy__row--3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .agwy__row--2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .agwy__row--5, .agwy__row--6 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .agwy__item {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 22px 22px 22px 22px;
    border-right: 1px solid #CFC4B0;
  }
  .agwy__item:first-child { padding-left: 0; }
  .agwy__item:last-child { border-right: 0; padding-right: 0; }
  .agwy__icon {
    display: inline-flex;
    color: #5C6B4C;
    margin-bottom: 6px;
  }
  .agwy__title {
    margin: 0;
    font-family: var(--font-accent--family);
    font-weight: 400;
    font-size: 17px;
    line-height: 1.25;
    color: #2F2A22;
  }
  .agwy__line {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: 13px;
    line-height: 1.5;
    color: #56503F;
  }
  .agwy__grid--photo {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 48px 64px;
    align-items: center;
  }
  .agwy__grid--right .agwy__figure { order: 2; }
  .agwy__figure { min-width: 0; }
  .agwy__photo {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 4px;
    background: #DED3C2;
    text-decoration: none;
  }
  .agwy__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform .8s ease;
  }
  a.agwy__photo:hover img { transform: scale(1.03); }
  .agwy__caption {
    position: absolute;
    left: 14px;
    bottom: 12px;
    padding: 6px 10px;
    background: rgba(251, 248, 242, .88);
    color: #2F2A22;
    border-radius: 2px;
    font-family: var(--font-body--family);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .agwy__content { min-width: 0; }
  @media screen and (max-width: 989px) {
    .agwy__grid--photo { grid-template-columns: 1fr; gap: 24px; }
    .agwy__grid--right .agwy__figure { order: 0; }
    .agwy__photo { aspect-ratio: 16 / 10; }
    .agwy__photo img { object-position: center 62%; }
    .agwy__caption { left: 10px; bottom: 10px; font-size: 10px; padding: 5px 8px; }
  }
  @media screen and (max-width: 749px) {
    .agwy__head { margin-block-end: 18px; }
    .agwy__row, .agwy__row--3, .agwy__row--5, .agwy__row--6 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .agwy__item { padding: 16px 14px; gap: 4px; }
    .agwy__item:nth-child(2n + 1) { padding-left: 0; border-right: 1px solid #CFC4B0; }
    .agwy__item:nth-child(2n) { padding-right: 0; border-right: 0; }
    .agwy__item:nth-child(n + 3) { border-top: 1px solid #CFC4B0; }
    .agwy__icon svg { width: 22px; height: 22px; }
    .agwy__title { font-size: 15px; }
    .agwy__line { font-size: 12.5px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Why AgaPlantz",
  "tag": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The AgaPlantz way" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why collectors choose AgaPlantz" },
    { "type": "text", "id": "text", "label": "One line (optional)" },
    { "type": "checkbox", "id": "show_numbers", "label": "Number the items (not used in the slim layout)", "default": false },
    { "type": "header", "content": "Photo" },
    { "type": "image_picker", "id": "image", "label": "Photo beside the reasons", "info": "Leave blank to use the product's first photo." },
    { "type": "product", "id": "product", "label": "Product (fallback photo and link)" },
    { "type": "url", "id": "image_link", "label": "Photo link", "info": "Leave blank to link to the product." },
    { "type": "text", "id": "image_caption", "label": "Small caption on the photo" },
    { "type": "select", "id": "image_position", "label": "Photo position on desktop", "options": [ { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" } ], "default": "left" },
    { "type": "header", "content": "Section layout" },
    { "type": "color", "id": "background_color", "label": "Background", "placeholder": "Default" },
    { "type": "range", "id": "padding-block-start", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding-block-end", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 }
  ],
  "blocks": [
    {
      "type": "reason",
      "name": "Reason",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "options": [
          { "value": "plant", "label": "Sprout" }, { "value": "leaf", "label": "Leaf" }, { "value": "box", "label": "Box" },
          { "value": "truck", "label": "Truck" }, { "value": "shield", "label": "Shield" }, { "value": "flask", "label": "Lab flask" },
          { "value": "thermometer", "label": "Thermometer" }, { "value": "pin", "label": "Map pin" }, { "value": "star", "label": "Star" },
          { "value": "chat", "label": "Chat" } ], "default": "plant" },
        { "type": "text", "id": "title", "label": "Title", "default": "Rooted before it ships" },
        { "type": "textarea", "id": "text", "label": "One line", "default": "Established and acclimated in our greenhouse, never straight from the lab." }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Why AgaPlantz",
      "category": "Text",
      "blocks": [
        { "type": "reason", "settings": { "icon": "plant", "title": "Rooted before it ships", "text": "Established and acclimated in our greenhouse, never straight from the lab." } },
        { "type": "reason", "settings": { "icon": "box", "title": "Packed for the season", "text": "Insulated boxes and heat packs right through the Canadian winter." } },
        { "type": "reason", "settings": { "icon": "truck", "title": "Shipped Canada-wide", "text": "Tracked delivery to every province, with local pickup in Brampton." } },
        { "type": "reason", "settings": { "icon": "leaf", "title": "Pest-free by design", "text": "Lab-propagated stock means no thrips, no mealybugs, no quarantine." } }
      ]
    }
  ]
}
{% endschema %}
