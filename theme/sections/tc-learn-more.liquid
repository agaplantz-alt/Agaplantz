{%- doc -%}
  AgaPlantz — a slim "What is tissue culture?" strip for the home page, pointing at the guide
  page. One line of copy and one link; sits between the genus tiles and the plant spotlight.
{%- enddoc -%}

{%- liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
-%}

<div class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"></div>

<div
  class="section section--page-width{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %} aglm"
  style="--padding-block-start: {{ section.settings.padding-block-start }}px; --padding-block-end: {{ section.settings.padding-block-end }}px;"
>
  <a class="aglm__row" href="{{ section.settings.link }}">
    <span class="aglm__icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 3h6v6a6 6 0 0 1-6 6V3z"/><path d="M12 15v6"/><path d="M8 21h8"/></svg>
    </span>
    <span class="aglm__copy">
      {%- if section.settings.eyebrow != blank -%}<span class="aglm__eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <span class="aglm__heading">{{ section.settings.heading }}</span>
      {%- if section.settings.text != blank -%}<span class="aglm__text">{{ section.settings.text }}</span>{%- endif -%}
    </span>
    <span class="aglm__cta">{{ section.settings.link_label }} <span aria-hidden="true">&rarr;</span></span>
  </a>
</div>

{% stylesheet %}
  .aglm {
    padding-block-start: var(--padding-block-start, 28px);
    padding-block-end: var(--padding-block-end, 28px);
  }
  .aglm__row {
    display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 18px;
    padding: 18px 22px; border: 1px solid #DED3C2; border-radius: 4px;
    background: rgb(251 248 242 / 0.6); color: inherit; text-decoration: none;
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }
  .aglm__row:hover, .aglm__row:focus { border-color: #5C6B4C; background: #FBF8F2; }
  .aglm__icon {
    display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px;
    border-radius: 50%; background: #5C6B4C; color: #FBF8F2;
  }
  .aglm__icon svg { width: 22px; height: 22px; }
  .aglm__copy { display: block; }
  .aglm__eyebrow { display: block; margin-block-end: 4px; color: #B4693C; font-size: 10px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; }
  .aglm__heading { display: block; font-family: var(--font-accent--family); font-weight: 400; font-size: clamp(19px, 2.6vw, 23px); line-height: 1.25; }
  .aglm__text { display: block; margin-block-start: 4px; font-size: 14px; line-height: 1.5; color: var(--color-foreground-muted, #56503F); }
  .aglm__cta { white-space: nowrap; font-size: 12px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: #5C6B4C; }
  @media screen and (max-width: 749px) {
    .aglm__row { grid-template-columns: auto 1fr; gap: 14px; padding: 16px; }
    .aglm__cta { grid-column: 2; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Tissue culture link strip",
  "tag": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "New here?" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What is a tissue culture plant?" },
    { "type": "text", "id": "text", "label": "One line", "default": "How our plants are grown, shipped and guaranteed — from the lab to your windowsill." },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Learn more" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "header", "content": "Section layout" },
    { "type": "color", "id": "background_color", "label": "Background", "placeholder": "Default" },
    { "type": "range", "id": "padding-block-start", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 28 },
    { "type": "range", "id": "padding-block-end", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 28 }
  ],
  "presets": [{ "name": "Tissue culture link strip", "category": "Promotions" }]
}
{% endschema %}
