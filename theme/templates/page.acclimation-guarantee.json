            },
            "text_need": {
              "type": "text",
              "settings": {
                "text": "<ul><li><strong>Get in touch within 30 days</strong> of the day your plant was delivered.</li><li><strong>Clear photos</strong> — one of the whole plant, one close up on what has gone wrong. We can’t assess a plant we can’t see.</li><li><strong>That you followed the <a href=\"/pages/acclimation-guide\">Acclimation Guide</a>.</strong> This is the one condition we hold to. A tissue culture plantlet comes out of a sterile lab at near 100% humidity, and the guide is what bridges it to life in your home. Plants that skip that step rarely settle in, and that isn’t something a replacement fixes.</li></ul>",
                "width": "100%",
                "max_width": "normal",
                "alignment": "left",
                "type_preset": "rte",
                "font": "var(--font-body--family)",
                "font_size": "",
                "line_height": "normal",
