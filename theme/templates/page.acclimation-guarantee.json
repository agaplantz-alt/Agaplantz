            "text_not_h": {
              "type": "text",
              "settings": {
                "text": "<h2>What’s not covered</h2>",
                "width": "100%",
                "max_width": "normal",
                "alignment": "left",
                "type_preset": "h3",
                "font": "var(--font-heading--family)",
                "font_size": "",
                "line_height": "normal",
