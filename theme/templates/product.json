    "store_reviews": {
      "type": "section",
      "blocks": {
        "store_reviews_html": {
          "type": "custom-liquid",
          "settings": {
            "custom_liquid": "{%- liquid\n  assign handles = 'philodendron-spiritus-sancti-rear,tissue-culture-starter-kit,philodendron-mcdowell,monstera-bulbasaur-pre-order,philodendron-tortum,monstera-placer-gold-pre-order,monstera-white-monster-pre-order,monstera-creme-brulee-pre-order,monstera-obliqua-peru,monstera-deliciosa-aurea-pre-order,monstera-devil-monster-premium-variegated-pre-order,monstera-deliciosa-banana-super-golden-pre-order,philodendron-billietiae-variegated-pre-order,philodendron-florida-beauty-x-tortum,alocasia-frydek-variegated-pre-order,philodendron-gloriosum-variegated-pre-order,philodendron-goeldii-mint,scindapsus-pictus-variegated' | split: ','\n  assign total_reviews = 0\n  assign rating_points = 0\n  comment\n    Review IDs kept out of the featured cards. Does NOT affect the average --\n    that still counts every review. These are photos where fogged plastic or\n    packing wool hides the plant, plus one whose text opens \"came slightly bent\".\n  endcomment\n  assign skip_ids = 'NI-wlpvmPy,qocHgh3EC,y_v4cpIr5,DTV_ekYSa,7_HgyjLD3,4aFr22Km3,zo6DsepPC,msGJdfGSP,ylk0aALpb' | split: ','\n  assign max_cards = 6\n  assign per_product = 4\n  assign min_rating = 4\n  assign current_handle = product.handle\n-%}\n{%- for h in handles -%}\n  {%- assign p = all_products[h] -%}\n  {%- assign n = p.metafields.loox.num_reviews.value -%}\n  {%- if n > 0 -%}\n    {%- assign total_reviews = total_reviews | plus: n -%}\n    {%- assign pts = p.metafields.loox.avg_rating.value | times: n -%}\n    {%- assign rating_points = rating_points | plus: pts -%}\n  {%- endif -%}\n{%- endfor -%}\n{%- if total_reviews > 0 -%}\n  {%- assign avg_all = rating_points | divided_by: total_reviews | round: 1 -%}\n  {%- assign avg_stars = avg_all | round -%}\n\n<div class=\"ap-reviews\">\n  <div class=\"ap-reviews__head\">\n    <h2>What collectors say about AgaPlantz</h2>\n    <p class=\"ap-reviews__agg\">\n      <span class=\"ap-stars\" aria-hidden=\"true\">{% for i in (1..5) %}{% if i <= avg_stars %}&#9733;{% else %}&#9734;{% endif %}{% endfor %}</span>\n      <span class=\"ap-reviews__agg-text\">{{ avg_all }} average from {{ total_reviews }} verified reviews</span>\n    </p>\n  </div>\n\n  <div class=\"ap-reviews__grid\">\n    {%- comment -%}\n      Round-robin: each pass takes at most one review per plant, so the strongest\n      photo from each plant lands first and no single plant fills the top of the row.\n    {%- endcomment -%}\n    {%- assign shown = 0 -%}\n    {%- assign taken = '' -%}\n    {%- for round in (1..per_product) -%}\n      {%- for h in handles -%}\n        {%- assign p = all_products[h] -%}\n        {%- assign feed = p.metafields.loox.review_feed.value -%}\n        {%- if feed.reviews and shown < max_cards and h != current_handle -%}\n          {%- assign picked = false -%}\n          {%- for r in feed.reviews -%}\n            {%- assign key = '|' | append: r.id | append: '|' -%}\n            {%- assign blocked = false -%}\n            {%- if skip_ids contains r.id -%}{%- assign blocked = true -%}{%- endif -%}\n            {%- if taken contains key -%}{%- assign blocked = true -%}{%- endif -%}\n            {%- if picked == false and shown < max_cards and r.rating >= min_rating and r.review.size > 25 and blocked == false -%}\n              {%- assign photo = '' -%}\n              {%- if r.media.size > 0 -%}{%- assign photo = r.media[0].src -%}\n              {%- elsif r.img.src -%}{%- assign photo = r.img.src -%}{%- endif -%}\n              {%- if photo != '' -%}\n                {%- assign picked = true -%}\n                {%- assign taken = taken | append: key -%}\n                {%- assign shown = shown | plus: 1 -%}\n                <figure class=\"ap-review\">\n                  <img class=\"ap-review__photo\" src=\"{{ photo }}\" alt=\"Customer photo of {{ p.title | escape }}\" loading=\"lazy\" width=\"600\" height=\"600\">\n                  <figcaption class=\"ap-review__body\">\n                    <span class=\"ap-stars ap-stars--sm\" aria-label=\"{{ r.rating }} out of 5\">{% for i in (1..5) %}{% if i <= r.rating %}&#9733;{% else %}&#9734;{% endif %}{% endfor %}</span>\n                    <blockquote class=\"ap-review__text\">{{ r.review | strip | truncate: 190 }}</blockquote>\n                    <span class=\"ap-review__who\">{{ r.author }}{% if r.verified %} &middot; Verified buyer{% endif %}</span>\n                    <a class=\"ap-review__product\" href=\"{{ p.url }}\">{{ p.title }}</a>\n                  </figcaption>\n                </figure>\n              {%- endif -%}\n            {%- endif -%}\n          {%- endfor -%}\n        {%- endif -%}\n      {%- endfor -%}\n    {%- endfor -%}\n  </div>\n</div>\n\n<style>\n  .ap-reviews { width: 100%; }\n  .ap-reviews__head { margin-block-end: 28px; }\n  .ap-reviews__head h2 {\n    font-family: var(--font-heading--family);\n    font-size: var(--font-size--h3);\n    color: var(--color-foreground);\n    margin: 0 0 8px;\n  }\n  .ap-reviews__agg { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin: 0; }\n  .ap-stars { color: #5C6B4C; letter-spacing: 2px; font-size: 1rem; line-height: 1; }\n  .ap-stars--sm { font-size: 0.8125rem; }\n  .ap-reviews__agg-text {\n    font-family: var(--font-body--family);\n    font-size: 0.9375rem;\n    color: var(--color-foreground);\n  }\n  .ap-reviews__grid {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 16px;\n  }\n  .ap-review {\n    margin: 0;\n    background: #FBF8F2;\n    border: 1px solid #DED3C2;\n    border-radius: 4px;\n    overflow: hidden;\n    display: flex;\n    flex-direction: column;\n  }\n  .ap-review__photo {\n    width: 100%;\n    aspect-ratio: 1 / 1;\n    object-fit: cover;\n    display: block;\n  }\n  .ap-review__body {\n    padding: 16px;\n    display: flex;\n    flex-direction: column;\n    gap: 8px;\n    flex: 1;\n  }\n  .ap-review__text {\n    margin: 0;\n    font-family: var(--font-body--family);\n    font-size: 0.9375rem;\n    line-height: 1.5;\n    color: var(--color-foreground);\n  }\n  .ap-review__who {\n    font-family: var(--font-subheading--family);\n    font-size: 0.6875rem;\n    letter-spacing: 0.08em;\n    text-transform: uppercase;\n    color: #56503F;\n  }\n  .ap-review__product {\n    margin-block-start: auto;\n    font-family: var(--font-body--family);\n    font-size: 0.8125rem;\n    color: #56503F;\n    text-decoration: underline;\n    text-underline-offset: 3px;\n  }\n  @media screen and (max-width: 989px) {\n    .ap-reviews__grid { grid-template-columns: repeat(2, 1fr); }\n  }\n  @media screen and (max-width: 749px) {\n    .ap-reviews__grid {\n      grid-auto-flow: column;\n      grid-auto-columns: 74%;\n      grid-template-columns: none;\n      overflow-x: auto;\n      scroll-snap-type: x mandatory;\n      -webkit-overflow-scrolling: touch;\n      margin-inline: -20px;\n      padding-inline: 20px;\n      scrollbar-width: none;\n    }\n    .ap-reviews__grid::-webkit-scrollbar { display: none; }\n    .ap-review { scroll-snap-align: start; }\n  }\n</style>\n{%- endif -%}"
          }
        }
      },
      "block_order": [
        "store_reviews_html"
      ],
      "settings": {
        "content_direction": "column",
        "vertical_on_mobile": true,
        "horizontal_alignment": "flex-start",
        "vertical_alignment": "flex-start",
        "align_baseline": false,
        "horizontal_alignment_flex_direction_column": "flex-start",
        "vertical_alignment_flex_direction_column": "center",
        "gap": 0,
        "section_width": "page-width",
        "section_height": "",
        "section_height_custom": 50,
        "background_media": "none",
        "background_color": "#F2EBDE",
        "video_position": "cover",
        "background_image_position": "cover",
        "toggle_overlay": false,
        "overlay_color": "#00000026",
        "overlay_style": "solid",
        "gradient_direction": "to top",
        "border": "none",
        "border_width": 1,
        "border_opacity": 100,
        "border_radius": 0,
        "padding-block-start": 56,
        "padding-block-end": 64
      }
    }
  },
