                "ph_b": {
                  "type": "text",
                  "settings": {
                    "text": "<p><strong>Before you do anything else, photograph your plant as it comes out of the box.</strong> One clear phone snap is enough.</p><p>This is the condition we cannot waive. It is the only way to tell a plant that arrived weak from one that arrived healthy and ran into trouble later — and it protects you as much as it protects us. If a plant turns up in poor shape, that photo is your evidence, not ours.</p><p><strong>No arrival photo, no claim.</strong></p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
