{% doc %}
  Renders the AgaPlantz Acclimation Guarantee line.

  This snippet is the single source of guarantee copy. The product block
  (blocks/acclimation-guarantee.liquid) and the cart (snippets/cart-summary.liquid)
  both render it, so wording changes happen here and nowhere else.

  @param {string} [context] - 'product' for the tiered line under Add to Cart, 'cart' for the
                              one-line reassurance near checkout. Defaults to 'product'.
  @param {number} [price] - The SELECTED variant's price in cents. Required for 'product'.
                            Pass the variant price, never product.price: product.price is the
                            product's minimum variant price, and plant stage is a variant here,
                            so a merged listing would quote the cheapest stage's tier.
  @param {number} [threshold_cents] - Tier boundary in cents. Defaults to 20000 ($200).
  @param {string} [shipping_amount] - Replacement shipping, already formatted. Defaults to '$14.99'.
  @param {string} [page_url] - The guarantee page. Defaults to '/pages/acclimation-guarantee'.
  @param {string} [heading] - Bold lead-in on the product line.
  @param {string} [under_text] - Copy below the threshold. '{shipping}' is substituted.
  @param {string} [over_text] - Copy at or above the threshold. '{shipping}' is substituted.
  @param {string} [cart_text] - Copy for the cart line.
  @param {string} [link_text] - Link label.
{% enddoc %}

{%- liquid
  assign ag_context = context | default: 'product'
  assign ag_threshold = threshold_cents | default: 20000
  assign ag_shipping = shipping_amount | default: '$14.99'
  assign ag_url = page_url | default: '/pages/acclimation-guarantee'
  assign ag_heading = heading | default: 'AgaPlantz Acclimation Guarantee'
  assign ag_link = link_text | default: 'How it works'

  assign default_under = 'Free replacement within 30 days if it doesn’t make it. You cover shipping ({shipping}).'
  assign default_over = 'Replacement at 50% of what you paid, within 30 days. You cover shipping ({shipping}).'
  assign default_cart = 'Covered by our Acclimation Guarantee'

  assign ag_under = under_text | default: default_under | replace: '{shipping}', ag_shipping
  assign ag_over = over_text | default: default_over | replace: '{shipping}', ag_shipping
  assign ag_cart = cart_text | default: default_cart

  assign ag_price = price | default: 0
  if ag_price < ag_threshold
    assign ag_body = ag_under
  else
    assign ag_body = ag_over
  endif
-%}

{%- capture ag_icon -%}
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    width="17"
    height="17"
    fill="none"
    stroke="#5C6B4C"
    stroke-width="1.75"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
    style="flex-shrink: 0; margin-block-start: 1px;"
  >
    <path d="M12 2.75 4.5 5.75v5.5c0 4.6 3.1 8.4 7.5 10 4.4-1.6 7.5-5.4 7.5-10v-5.5Z" />
    <path d="m9 12 2.25 2.25L15.5 10" />
  </svg>
{%- endcapture -%}

{%- if ag_context == 'cart' -%}
  <div
    class="acclimation-guarantee acclimation-guarantee--cart"
    style="
      display: flex;
      align-items: flex-start;
      gap: 8px;
      width: 100%;
      margin-block-start: 12px;
      font-family: var(--font-body--family);
      font-size: 0.8125rem;
      line-height: 1.45;
      color: #56503F;
      text-align: start;
    "
  >
    {{ ag_icon }}
    <span>
      {{- ag_cart }}
      <a
        href="{{ ag_url }}"
        style="color: #2F2A22; text-underline-offset: 2px;"
      >{{ ag_link }}</a>.
    </span>
  </div>
{%- else -%}
  <div
    class="acclimation-guarantee acclimation-guarantee--product"
    style="
      display: flex;
      align-items: flex-start;
      gap: 10px;
      width: 100%;
      padding: 12px 14px;
      border: 1px solid #DED3C2;
      border-radius: 2px;
      background-color: #F2EBDE;
      font-family: var(--font-body--family);
      font-size: 0.8125rem;
      line-height: 1.5;
      color: #56503F;
      text-align: start;
      box-sizing: border-box;
    "
  >
    {{ ag_icon }}
    <span>
      <strong style="color: #2F2A22; font-weight: 600;">{{ ag_heading }}</strong>
      <br>
      {{ ag_body }}
      <a
        href="{{ ag_url }}"
        style="color: #2F2A22; white-space: nowrap; text-underline-offset: 2px;"
      >{{ ag_link }}&nbsp;&rarr;</a>
    </span>
  </div>
{%- endif -%}
